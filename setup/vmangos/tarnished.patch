@@ -0,0 +1,508 @@
+// SPDX-License-Identifier: MIT OR Apache-2.0
+// v2 capability, v1 envelopes with optional reference-stamina tails; see protocol/tarnished.rs.
+#include "Tarnished.h"
+#include "Chat.h"
+#include "Player.h"
+#include "Map.h"
+#include "Timer.h"
+#include "Opcodes.h"
+#include "UpdateData.h"
+#include "PlayerBroadcaster.h"
+#include <atomic>
+#include <cmath>
+#include <limits>
+#include <random>
+#include <unordered_set>
+
+namespace Tarnished
+{
+    static bool Newer(uint32 value, uint32 previous)
+    {
+        uint32 delta = value - previous;
+        return delta && delta < 0x80000000u;
+    }
+
+    static bool Equipped(Player const* player)
+    {
+        Item* sword = player->GetWeaponForAttack(BASE_ATTACK, true, true);
+        Item* shield = player->GetItemByPos(INVENTORY_SLOT_BAG_0, EQUIPMENT_SLOT_OFFHAND);
+        return player->GetClass() == CLASS_WARRIOR && sword && shield && !shield->IsBroken() &&
+            sword->GetProto()->Class == ITEM_CLASS_WEAPON &&
+            sword->GetProto()->SubClass == ITEM_SUBCLASS_WEAPON_SWORD &&
+            shield->GetProto()->Class == ITEM_CLASS_ARMOR &&
+            shield->GetProto()->SubClass == ITEM_SUBCLASS_ARMOR_SHIELD &&
+            !player->IsMounted() && !player->IsNoWeaponShapeShift();
+    }
+
+    bool Active(Unit const* unit)
+    {
+        Player const* player = unit ? unit->ToPlayer() : nullptr;
+        return player && player->IsInWorld() && player->IsAlive() &&
+            !player->IsBeingTeleported() && player->tarnished.capable &&
+            player->tarnished.active && Equipped(player) &&
+            WorldTimer::getMSTimeDiff(player->tarnished.poseReceipt, WorldTimer::getMSTime()) <= 2000;
+    }
+
+    static bool Allowed(Unit const* source, Unit const* target, bool melee)
+    {
+        return source && target && source != target && source->IsInWorld() && target->IsInWorld() &&
+            (source->IsAlive() || !melee) && target->IsAlive() && source->GetMap() == target->GetMap() &&
+            source->CanAttack(target) && source->IsWithinLOSInMap(target) &&
+            (!melee || source->IsWithinDistInMap(target, 8.f)) &&
+            !(target->IsCreature() && target->ToCreature()->IsInEvadeMode());
+    }
+
+    bool SpellSupported(SpellEntry const* spell)
+    {
+        for (unsigned i = 0; i < MAX_EFFECT_INDEX; ++i)
+            if (spell->Effect[i] != SPELL_EFFECT_NONE &&
+                spell->Effect[i] != SPELL_EFFECT_APPLY_AURA &&
+                spell->Effect[i] != SPELL_EFFECT_DISPEL &&
+                !spell->IsEffectHandledOnDelayedSpellLaunch(SpellEffectIndex(i)))
+                return false;
+        return true;
+    }
+
+    static void Relay(Player const* sender, WorldPacket const& packet)
+    {
+        ObjectGuidSet observers;
+        if (sender->m_broadcaster)
+            observers = sender->m_broadcaster->GetListenerGuids();
+        else
+            for (auto const& ref : sender->GetMap()->GetPlayers())
+                observers.insert(ref.getSource()->GetObjectGuid());
+        for (auto const& guid : observers)
+        {
+            Player* observer = sender->GetMap()->GetPlayer(guid);
+            if (observer && observer != sender && observer->tarnished.capable &&
+                observer->IsInVisibleList(sender))
+                observer->GetSession()->SendPacket(&packet);
+        }
+    }
+
+    static WorldPacket PosePacket(Player const* sender)
+    {
+        WorldPacket packet(SMSG_TARNISHED, 13 + sender->tarnished.pose.size());
+        packet << uint8(0x11) << uint64(sender->GetGUID()) << sender->tarnished.poseReceipt;
+        packet.append(sender->tarnished.pose);
+        return packet;
+    }
+
+    void QueueCreate(Player const* sender, Player* observer, UpdateData& data)
+    {
+        if (sender != observer && observer->tarnished.capable && Active(sender))
+            data.AddSkateVisual(PosePacket(sender));
+    }
+
+    static void StopPose(Player* player)
+    {
+        auto& state = player->tarnished;
+        if (state.active && player->IsInWorld())
+        {
+            state.pose.resize(47);
+            state.pose[14] = 0;
+            state.pose[15] = 0;
+            state.pose[46] = 0;
+            ++state.poseSequence;
+            for (unsigned i = 0; i < 4; ++i)
+                state.pose[6 + i] = uint8(state.poseSequence >> (i * 8));
+            state.poseReceipt = WorldTimer::getMSTime();
+            Relay(player, PosePacket(player));
+        }
+        state.active = false;
+        state.blockedBout = state.hasPose;
+        state.retiredBout = state.bout;
+        state.pose.clear();
+    }
+
+    static void Resolve(Player* player, Pending pending, Answer const* answer)
+    {
+        // No raw source pointer survives the delay; map removal can delete creatures.
+        Unit* source = player->IsInWorld() ? player->GetMap()->GetUnit(pending.source) : nullptr;
+        // Always release continuations (including spell lifetime holds) even if the source is gone.
+        pending.finish(Allowed(source, player, pending.melee) ? source : nullptr, player, answer);
+    }
+
+    void Clear(Player* player, bool login)
+    {
+        auto& state = player->tarnished;
+        StopPose(player);
+        auto pending = std::move(state.pending);
+        state.pending.clear();
+        for (auto& hit : pending)
+            Resolve(player, std::move(hit), nullptr);
+        if (login)
+            state = State{};
+        state.entry = WorldTimer::getMSTime();
+    }
+
+    void Update(Player* player)
+    {
+        auto& state = player->tarnished;
+        if (state.active && !Active(player))
+            StopPose(player);
+        uint32 now = WorldTimer::getMSTime();
+        while (!state.pending.empty() &&
+               (!Active(player) || WorldTimer::getMSTimeDiff(state.pending.front().receipt, now) >= TIMEOUT))
+        {
+            Pending pending = std::move(state.pending.front());
+            state.pending.pop_front();
+            Resolve(player, std::move(pending), nullptr);
+        }
+    }
+
+    void ClearSource(Unit* source)
+    {
+        if (!source->IsInWorld())
+            return;
+        for (auto const& ref : source->GetMap()->GetPlayers())
+        {
+            Player* player = ref.getSource();
+            auto& pending = player->tarnished.pending;
+            for (auto it = pending.begin(); it != pending.end();)
+            {
+                if (it->source != source->GetObjectGuid())
+                {
+                    ++it;
+                    continue;
+                }
+                Pending hit = std::move(*it);
+                it = pending.erase(it);
+                // Release spell holds before the caster's event queue is destroyed.
+                hit.finish(nullptr, player, nullptr);
+            }
+        }
+    }
+
+    bool Addon(Player* player, std::string const& message)
+    {
+        if (message.compare(0, 10, "TARNISHED\t") != 0)
+            return false;
+        auto& state = player->tarnished;
+        uint32 now = WorldTimer::getMSTime();
+        if (message != "TARNISHED\tV\t2" ||
+            (state.discovered && WorldTimer::getMSTimeDiff(state.capsReceipt, now) < 1000))
+            return true;
+        state.discovered = true;
+        state.capsReceipt = now;
+        WorldPacket response;
+        ChatHandler::BuildChatPacket(response, CHAT_MSG_PARTY, "TARNISHED\tCAPS\t2", LANG_ADDON,
+                                     CHAT_TAG_NONE, ObjectGuid());
+        player->GetSession()->SendPacket(&response);
+        return true;
+    }
+
+    bool Defer(Unit* source, Player* defender, uint32 amount, uint8 school, bool melee,
+               std::function<void(Unit*, Player*, Answer const*)> finish, uint32 stamina)
+    {
+        if (!Active(defender) || !Allowed(source, defender, melee) ||
+            defender->tarnished.pending.size() >= 64)
+            return false;
+        // A seeded bijection of a process-wide counter: never reuse a token, even after reconnect.
+        static uint32 const seed = std::random_device{}();
+        static std::atomic<uint64> serial{1};
+        uint64 number = serial.fetch_add(1);
+        if (number > std::numeric_limits<uint32>::max())
+            return false;
+        uint32 token = uint32(number) ^ seed;
+        Pending pending;
+        pending.token = token;
+        pending.receipt = WorldTimer::getMSTime();
+        pending.source = source->GetObjectGuid();
+        pending.amount = amount;
+        pending.melee = melee;
+        pending.finish = std::move(finish);
+        defender->tarnished.pending.push_back(std::move(pending));
+        WorldPacket packet(SMSG_TARNISHED, 19);
+        packet << uint8(0x13) << token << uint64(source->GetGUID()) << school << amount << uint8(melee);
+        if (stamina != std::numeric_limits<uint32>::max())
+            packet << stamina;
+        defender->GetSession()->SendPacket(&packet);
+        return true;
+    }
+
+    static bool Float(ByteBuffer& data, float& value, float bound)
+    {
+        if (data.size() - data.rpos() < 4)
+            return false;
+        data >> value;
+        return std::isfinite(value) && std::abs(value) <= bound;
+    }
+
+    static bool Transform(ByteBuffer& data, bool scale, float bound)
+    {
+        float value, norm = 0.f;
+        for (unsigned i = 0; i < 3; ++i)
+            if (!Float(data, value, bound))
+                return false;
+        for (unsigned i = 0; i < 4; ++i)
+        {
+            if (!Float(data, value, 1.1f))
+                return false;
+            norm += value * value;
+        }
+        if (norm < .9f || norm > 1.1f)
+            return false;
+        if (scale)
+            for (unsigned i = 0; i < 3; ++i)
+                if (!Float(data, value, 100.f) || value < .001f)
+                    return false;
+        return true;
+    }
+
+    static bool Pose(ByteBuffer data, uint32& bout, uint32& sequence, bool& active)
+    {
+        if (data.size() < 47)
+            return false;
+        data.rpos(2);
+        uint32 sample;
+        uint8 on, guard, joints;
+        uint16 action;
+        data >> bout >> sequence >> sample >> on >> guard >> action;
+        if (on > 1 || guard > 1 || !Transform(data, false, 1000000.f))
+            return false;
+        active = on != 0;
+        data >> joints;
+        if (joints > 96 || (!active && joints))
+            return false;
+        std::unordered_set<std::string> names;
+        for (unsigned i = 0; i < joints; ++i)
+        {
+            if (data.rpos() == data.size())
+                return false;
+            uint8 length;
+            data >> length;
+            if (!length || length > 48 || data.size() - data.rpos() < length)
+                return false;
+            std::string name;
+            for (unsigned j = 0; j < length; ++j)
+            {
+                uint8 ch;
+                data >> ch;
+                if (!((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
+                      (ch >= '0' && ch <= '9') || ch == '_'))
+                    return false;
+                name += char(ch);
+            }
+            if (!names.insert(name).second || !Transform(data, true, 10000.f))
+                return false;
+        }
+        return data.rpos() == data.size();
+    }
+
+    static bool Budget(State& state, uint32 now, bool pose, bool off)
+    {
+        now = WorldTimer::getMSTime(); // mailbox and command receipt times need not be ordered
+        uint32 elapsed = WorldTimer::getMSTimeDiff(state.budgetTime, now);
+        state.poseTokens = std::min(3.f, state.poseTokens + elapsed * .03f);
+        state.commandTokens = std::min(64.f, state.commandTokens + elapsed * .064f);
+        state.budgetTime = now;
+        float& tokens = pose ? state.poseTokens : state.commandTokens;
+        if (tokens < (pose && !off ? 2.f : 1.f))
+            return false;
+        tokens -= 1.f;
+        return true;
+    }
+
+    static bool ContactBatch(State const& state, uint32 id, uint8 weapon, uint8 kind,
+                             std::unordered_set<uint64> const& guids,
+                             uint32 stamina = std::numeric_limits<uint32>::max())
+    {
+        if (!state.hasAttack)
+            return true;
+        if (id != state.attackId)
+            return Newer(id, state.attackId);
+        if (weapon != state.attackWeapon || kind != state.attackKind || stamina != state.attackStamina ||
+            state.attackTargets.size() + guids.size() > 16)
+            return false;
+        for (uint64 guid : guids)
+            if (state.attackTargets.count(guid))
+                return false;
+        return true;
+    }
+
+    static void Attack(Player* player, ByteBuffer data, uint32 received)
+    {
+        if (!Active(player) || data.size() < 30)
+            return;
+        data.rpos(2);
+        uint32 sequence, id, sample;
+        uint8 weapon, kind, count;
+        data >> sequence >> id >> sample >> weapon >> kind >> count;
+        // The approved slice is one-handed sword plus shield, not arbitrary movesets.
+        if ((weapon != 1 && weapon != 24) || kind > 19 || !count || count > 16 ||
+            (data.size() != 17 + size_t(count) * 13 && data.size() != 21 + size_t(count) * 13))
+            return;
+        struct Contact { Unit* target; uint32 damage; uint8 flags; };
+        std::vector<Contact> contacts;
+        std::unordered_set<uint64> seen;
+        for (unsigned i = 0; i < count; ++i)
+        {
+            uint64 guid;
+            uint32 damage;
+            uint8 flags;
+            data >> guid >> damage >> flags;
+            Unit* target = player->GetMap()->GetUnit(ObjectGuid(guid));
+            if (!guid || flags > 3 || damage > 1000000 || !seen.insert(guid).second ||
+                !Allowed(player, target, true))
+                return;
+            contacts.push_back({target, damage, flags});
+        }
+        uint32 stamina = std::numeric_limits<uint32>::max();
+        if (data.rpos() != data.size())
+        {
+            data >> stamina;
+            if (stamina > 1000000000)
+                return;
+        }
+        auto& state = player->tarnished;
+        bool sameSwing = state.hasAttack && id == state.attackId;
+        if ((state.hasCommand && !Newer(sequence, state.commandSequence)) ||
+            !ContactBatch(state, id, weapon, kind, seen, stamina) ||
+            !Budget(state, received, false, false))
+            return;
+        if (!sameSwing)
+            state.attackTargets.clear();
+        state.attackWeapon = weapon;
+        state.attackKind = kind;
+        state.attackStamina = stamina;
+        for (auto const& contact : contacts)
+            state.attackTargets.insert(contact.target->GetGUID());
+        state.hasCommand = state.hasAttack = true;
+        state.commandSequence = sequence;
+        state.attackId = id;
+        WorldPacket relay(SMSG_TARNISHED, 13 + data.size());
+        relay << uint8(0x12) << uint64(player->GetGUID()) << received;
+        relay.append(data.contents(), data.size());
+        Relay(player, relay);
+        for (auto const& contact : contacts)
+        {
+            CalcDamageInfo hit;
+            // Offence supplies pre-armour damage; native bonus/crit/glance rolls must not repeat it.
+            player->CalculateTarnishedMelee(contact.target, contact.damage, contact.flags, &hit);
+            auto finish = [hit](Unit* source, Player* defender, Answer const* answer) mutable
+            {
+                if (!source)
+                    return;
+                hit.attacker = source;
+                hit.target = defender;
+                source->FinishTarnishedMelee(&hit, answer, false);
+            };
+            if (!Defer(player, contact.target->ToPlayer(), hit.totalDamage, 0, true, finish, stamina))
+                player->FinishTarnishedMelee(&hit, nullptr, false);
+        }
+    }
+
+    static void Defence(Player* player, ByteBuffer data, uint32 received)
+    {
+        if (data.size() < 19)
+            return;
+        data.rpos(2);
+        uint32 sequence, token;
+        uint64 guid;
+        uint8 outcome;
+        data >> sequence >> token >> guid >> outcome;
+        Answer answer;
+        answer.outcome = outcome;
+        if (outcome <= 2)
+        {
+            if (data.size() != 19)
+                return;
+        }
+        else if (outcome == 3)
+        {
+            if (data.size() != 30)
+                return;
+            uint16 stamina;
+            uint8 broken;
+            data >> answer.absorbed >> stamina >> broken >> answer.taken;
+            if (broken > 1)
+                return;
+        }
+        else if (outcome == 4)
+        {
+            if (data.size() != 23)
+                return;
+            data >> answer.taken;
+        }
+        else
+            return;
+        auto& state = player->tarnished;
+        if (!Active(player) || (state.hasCommand && !Newer(sequence, state.commandSequence)))
+            return;
+        auto it = std::find_if(state.pending.begin(), state.pending.end(),
+            [token](Pending const& hit) { return hit.token == token; });
+        if (it == state.pending.end() || uint64(it->source) != guid ||
+            WorldTimer::getMSTimeDiff(it->receipt, received) >= TIMEOUT ||
+            WorldTimer::getMSTimeDiff(it->receipt, WorldTimer::getMSTime()) >= TIMEOUT ||
+            ((outcome == 1 || outcome == 2) && !it->melee) ||
+            (outcome == 3 && uint64(answer.absorbed) + answer.taken != it->amount) ||
+            (outcome == 4 && answer.taken != it->amount) ||
+            !Budget(state, received, false, false))
+            return;
+        state.hasCommand = true;
+        state.commandSequence = sequence;
+        Pending pending = std::move(*it);
+        state.pending.erase(it); // erase before procs can re-enter combat
+        Resolve(player, std::move(pending), &answer);
+    }
+
+    void Handle(Player* player, ByteBuffer data, uint32 received)
+    {
+        if (!player || !player->IsInWorld() || player->IsBeingTeleported() ||
+            data.size() < 2 || data.size() > 8179 || data.read<uint8>(0) != 1)
+            return;
+        auto& state = player->tarnished;
+        uint32 now = WorldTimer::getMSTime();
+        if ((WorldTimer::getMSTimeDiff(state.entry, now) < 5000 && !Newer(received, state.entry)) ||
+            WorldTimer::getMSTimeDiff(received, now) > 2000)
+            return;
+        uint8 kind = data.read<uint8>(1);
+        if (kind == 0)
+        {
+            if (data.size() != 2 || !state.discovered || !Budget(state, received, false, false))
+                return;
+            state.capable = true;
+            WorldPacket ack(SMSG_TARNISHED, 2);
+            ack << uint8(1) << uint8(0);
+            player->GetSession()->SendPacket(&ack);
+            for (auto const& ref : player->GetMap()->GetPlayers())
+            {
+                Player* sender = ref.getSource();
+                if (sender != player && Active(sender) && player->IsInVisibleList(sender))
+                {
+                    WorldPacket packet = PosePacket(sender);
+                    player->GetSession()->SendPacket(&packet);
+                }
+            }
+            return;
+        }
+        if (!state.capable)
+            return;
+        if (kind == 2)
+            Attack(player, data, received);
+        else if (kind == 3)
+            Defence(player, data, received);
+        else if (kind == 4)
+        {
+            uint32 bout, sequence;
+            bool active;
+            if (!Pose(data, bout, sequence, active) || (active && !Equipped(player)) ||
+                (state.blockedBout && !Newer(bout, state.retiredBout)) ||
+                (state.hasPose && (bout == state.bout ? !Newer(sequence, state.poseSequence) :
+                                                     !Newer(bout, state.bout))) ||
+                !Budget(state, received, true, state.active && !active))
+                return;
+            // coords::wow_to_bevy is (-y, z, -x); poses never relocate authoritative players.
+            float y = -data.read<float>(18), z = data.read<float>(22), x = -data.read<float>(26);
+            float dx = x - player->GetPositionX(), dy = y - player->GetPositionY(), dz = z - player->GetPositionZ();
+            if (dx * dx + dy * dy + dz * dz > 64.f)
+                return;
+            state.bout = bout;
+            state.poseSequence = sequence;
+            state.hasPose = true;
+            state.blockedBout = !active;
+            state.retiredBout = bout;
+            state.active = active;
+            state.poseReceipt = received;
+            state.pose.assign(data.contents(), data.contents() + data.size());
+            Relay(player, PosePacket(player));
+            if (!active)
+                Update(player);
+        }
+    }
+}
+
+void WorldSession::HandleTarnished(TarnishedPacket const& packet)
+{
+    Tarnished::Handle(GetPlayer(), packet.payload, packet.received);
+}
diff --git a/src/game/Tarnished.h b/src/game/Tarnished.h
new file mode 100644
--- /dev/null
+++ b/src/game/Tarnished.h
@@ -0,0 +1,90 @@
+// SPDX-License-Identifier: MIT OR Apache-2.0
+#ifndef TARNISHED_H
+#define TARNISHED_H
+#include "Common.h"
+#include "Packet.h"
+#include "ObjectGuid.h"
+#include <deque>
+#include <functional>
+#include <limits>
+#include <unordered_set>
+#include <vector>
+
+class Player;
+class Unit;
+class UpdateData;
+class SpellEntry;
+
+class TarnishedPacket final : public ClientPacket
+{
+public:
+    TarnishedPacket() : ClientPacket(OPCODE_WILL_BE_SET_IN_READ_FUNCTION) {}
+    ByteBuffer payload;
+    uint32 received = 0;
+    void ReadFromWorldPacket(WorldPacket& packet) override
+    {
+        opcode = packet.GetOpcode();
+        received = packet.GetPacketTime();
+        if (packet.size() >= 2 && packet.size() <= 8179)
+            payload.append(packet.contents(), packet.size());
+        packet.rpos(packet.size());
+    }
+};
+
+namespace Tarnished
+{
+    constexpr uint32 TIMEOUT = 350;
+    // A null answer resumes precisely the stock continuation.
+    struct Answer
+    {
+        uint8 outcome = 4;
+        uint32 taken = 0;
+        uint32 absorbed = 0;
+    };
+    struct Pending
+    {
+        uint32 token = 0;
+        uint32 receipt = 0;
+        ObjectGuid source;
+        uint32 amount = 0;
+        bool melee = false;
+        std::function<void(Unit*, Player*, Answer const*)> finish;
+    };
+    // All state belongs to the player's map thread, never the socket/chat thread.
+    struct State
+    {
+        bool discovered = false;
+        bool capable = false;
+        bool active = false;
+        bool hasPose = false;
+        bool blockedBout = false;
+        uint32 retiredBout = 0;
+        uint32 entry = 0;
+        uint32 capsReceipt = 0;
+        uint32 poseReceipt = 0;
+        uint32 bout = 0;
+        uint32 poseSequence = 0;
+        uint32 commandSequence = 0;
+        uint32 attackId = 0;
+        uint8 attackWeapon = 0;
+        uint8 attackKind = 0;
+        uint32 attackStamina = std::numeric_limits<uint32>::max();
+        std::unordered_set<uint64> attackTargets;
+        bool hasCommand = false;
+        bool hasAttack = false;
+        uint32 budgetTime = 0;
+        float poseTokens = 3.f;
+        float commandTokens = 64.f;
+        std::vector<uint8> pose;
+        std::deque<Pending> pending;
+    };
+    bool Addon(Player*, std::string const&);
+    void Handle(Player*, ByteBuffer, uint32);
+    bool Active(Unit const*);
+    bool SpellSupported(SpellEntry const*);
+    bool Defer(Unit*, Player*, uint32, uint8, bool,
+               std::function<void(Unit*, Player*, Answer const*)>,
+               uint32 stamina = std::numeric_limits<uint32>::max());
+    void Update(Player*);
+    void Clear(Player*, bool login = false);
+    void ClearSource(Unit*);
+    void QueueCreate(Player const*, Player*, UpdateData&);
+}
+#endif
