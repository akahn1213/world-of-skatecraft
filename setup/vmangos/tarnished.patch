+int32 Unit::CalculateDamageResistance(SpellCaster* caster, SpellSchoolMask school, DamageEffectType type, uint32 damage, SpellEntry const* spell)
+{
+    if (!caster || !damage || !IsAlive())
+        return 0;
+    bool canResist = (school & SPELL_SCHOOL_MASK_NORMAL) == 0;
+    if (spell && (spell->IsBinary() || (spell->AttributesEx4 & SPELL_ATTR_EX4_IGNORE_RESISTANCES)))
+        canResist = false;
+    float chance = caster->GetSpellResistChance(this, school, true);
+    if (!canResist && chance >= 0)
+        return 0;
+    float multiplier = RollMagicResistanceMultiplierOutcomeAgainst(chance, school, type, spell);
+    return rand_dither(int64(damage) * multiplier);
+}
+
+void Unit::CalculateTarnishedMelee(Unit* target, uint32 damage, uint8 flags, CalcDamageInfo* hit)
+{
+    hit->attacker = this;
+    hit->target = target;
+    hit->attackType = BASE_ATTACK;
+    hit->subDamage[0].damageSchoolMask = SPELL_SCHOOL_MASK_NORMAL;
+    hit->procAttacker = PROC_FLAG_DEAL_MELEE_SWING | PROC_FLAG_MAIN_HAND_WEAPON_SWING;
+    hit->procVictim = PROC_FLAG_TAKE_MELEE_SWING;
+    SetDamageIndependentHitInfoFlags(hit->HitInfo, target, BASE_ATTACK);
+    if (target->IsImmuneToDamage(SPELL_SCHOOL_MASK_NORMAL))
+    {
+        hit->TargetState = VICTIMSTATE_IS_IMMUNE;
+        hit->procEx = PROC_EX_IMMUNE;
+        return;
+    }
+    hit->totalDamage = rand_ditheru(CalcArmorReducedDamage(target, damage));
+    hit->subDamage[0].damage = hit->totalDamage;
+    hit->cleanDamage = damage - hit->totalDamage;
+    if (flags & 1)
+        hit->HitInfo |= HITINFO_CRITICALHIT;
+    if (flags & 2)
+        hit->HitInfo |= HITINFO_GLANCING;
+}
+
+void Unit::FinishTarnishedMelee(CalcDamageInfo* hit, Tarnished::Answer const* answer, bool stock)
+{
+    if (!hit->target->IsAlive() || !IsAlive() || GetMap() != hit->target->GetMap())
+        return;
+    FinishMeleeCalculation(hit, answer, true, !stock);
+    if (hit->hitOutCome == MELEE_HIT_MISS)
+        hit->HitInfo |= HITINFO_MISS;
+    else
+        hit->HitInfo &= ~HITINFO_MISS;
+    if (hit->hitOutCome == MELEE_HIT_BLOCK)
+        hit->HitInfo |= HITINFO_BLOCK;
+    else
+        hit->HitInfo &= ~HITINFO_BLOCK;
+    // Designated offence already included these modifiers in the supplied amount.
+    if (hit->hitOutCome == MELEE_HIT_MISS || hit->hitOutCome == MELEE_HIT_DODGE ||
+        hit->hitOutCome == MELEE_HIT_PARRY)
+        hit->HitInfo &= ~(HITINFO_CRITICALHIT | HITINFO_GLANCING | HITINFO_CRUSHING);
+    if (!stock && hit->totalDamage && (hit->HitInfo & HITINFO_CRITICALHIT) &&
+        (hit->hitOutCome == MELEE_HIT_NORMAL || hit->hitOutCome == MELEE_HIT_BLOCK))
+    {
+        hit->procEx &= ~PROC_EX_NORMAL_HIT;
+        hit->procEx |= PROC_EX_CRITICAL_HIT;
+        if (hit->hitOutCome == MELEE_HIT_NORMAL)
+            hit->hitOutCome = MELEE_HIT_CRIT;
+    }
+    ApplyMeleeDamage(*hit);
+}
