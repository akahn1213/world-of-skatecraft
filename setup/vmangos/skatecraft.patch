diff --git a/src/game/Skatecraft.cpp b/src/game/Skatecraft.cpp
new file mode 100644
index 0000000..b34bca5
--- /dev/null
+++ b/src/game/Skatecraft.cpp
@@ -0,0 +1,436 @@
+#include "Skatecraft.h"
+#include "Database/DBCStores.h"
+#include "Chat.h"
+#include "Player.h"
+#include "SpellMgr.h"
+#include "Timer.h"
+#include "Map.h"
+#include "Opcodes.h"
+#include "UpdateData.h"
+#include "PlayerBroadcaster.h"
+
+#include <cstdlib>
+#include <cmath>
+#include <unordered_set>
+#include <unordered_map>
+
+extern SkillRaceClassInfoMap SkillRaceClassInfoBySkill;
+
+namespace Skatecraft
+{
+    // SpellIcon.dbc
+    constexpr uint32 ICON_MECHASTRIDER = 1240;
+    constexpr uint32 ICON_BOOTS        = 230;
+    constexpr uint32 ICON_FLARE        = 136;
+    constexpr uint32 ICON_SPRINT       = 516;
+    constexpr uint32 ICON_MOONGLOW     = 46;
+
+    // A skill tier of one 300 step, so the skill keeps its own max rather than following level.
+    constexpr uint32 SKILL_TIER_300 = 181;
+    constexpr uint32 SKILL_CATEGORY_SECONDARY = 9;
+
+    // Lines closer together than this are not counted (ms).
+    constexpr uint32 LINE_INTERVAL = 1000;
+    // A reported line is clamped to this many points.
+    constexpr float MAX_LINE_POINTS = 100000.f;
+
+    struct Unlock { uint32 skill; uint32 spell; };
+    constexpr Unlock UNLOCKS[] = {
+        {   1, SPELL_SUMMON_SKATEBOARD },
+        {  75, SPELL_OLLIE_BOOST },
+        { 150, SPELL_ROCKET_BOOST },
+        { 225, SPELL_SPEED_DEMON },
+        { 300, SPELL_MOON_JUMP },
+    };
+
+    static char s_skillName[] = "Skateboarding";
+    static char s_empty[] = "";
+    static SkillLineEntry s_skillLine;
+    static SkillRaceClassInfoEntry s_raceClass;
+
+    static std::unordered_map<uint32, uint32> s_lastLine; // player guid low -> ms
+
+    // Extension only: visual poses never relocate the authoritative WoW player or bypass anticheat.
+    static bool ReadFloat(ByteBuffer& data, float& value, float bound)
+    {
+        if (data.size() - data.rpos() < sizeof(float))
+            return false;
+        data >> value;
+        return std::isfinite(value) && std::abs(value) <= bound;
+    }
+
+    static bool ReadTransform(ByteBuffer& data, bool scale, float bound)
+    {
+        float value;
+        for (unsigned i = 0; i < 3; ++i)
+            if (!ReadFloat(data, value, bound))
+                return false;
+        float norm = 0.f;
+        for (unsigned i = 0; i < 4; ++i)
+        {
+            if (!ReadFloat(data, value, 1.1f))
+                return false;
+            norm += value * value;
+        }
+        if (norm < .9f || norm > 1.1f)
+            return false;
+        if (scale)
+            for (unsigned i = 0; i < 3; ++i)
+                if (!ReadFloat(data, value, 100.f) || value < .001f)
+                    return false;
+        return true;
+    }
+
+    static bool ValidateVisual(ByteBuffer& data, uint32& ride, uint32& sequence, bool& active)
+    {
+        if (data.size() < 44 || data.size() > 8192)
+            return false;
+        data.rpos(2);
+        uint32 sample;
+        uint8 flag, joints;
+        data >> ride >> sequence >> sample >> flag;
+        if (flag > 1 || !ReadTransform(data, false, 1000000.f))
+            return false;
+        active = flag != 0;
+        data >> joints;
+        if (joints > 96 || (!active && joints != 0))
+            return false;
+        std::unordered_set<std::string> names;
+        for (unsigned i = 0; i < joints; ++i)
+        {
+            if (data.rpos() == data.size())
+                return false;
+            uint8 length;
+            data >> length;
+            if (!length || length > 48 || data.size() - data.rpos() < length)
+                return false;
+            std::string name;
+            for (unsigned j = 0; j < length; ++j)
+            {
+                uint8 ch;
+                data >> ch;
+                if (!((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
+                      (ch >= '0' && ch <= '9') || ch == '_'))
+                    return false;
+                name += char(ch);
+            }
+            if (!names.insert(name).second || !ReadTransform(data, true, 10000.f))
+                return false;
+        }
+        return data.rpos() == data.size();
+    }
+
+    static WorldPacket VisualPacket(Player const* sender)
+    {
+        auto const& state = sender->skateVisual;
+        WorldPacket packet(SMSG_SKATECRAFT_VISUAL, 12 + state.payload.size());
+        packet << uint64(sender->GetGUID()) << state.receipt;
+        packet.append(state.payload);
+        return packet;
+    }
+
+    static void RelayVisual(Player* sender)
+    {
+        WorldPacket packet = VisualPacket(sender);
+        ObjectGuidSet observers;
+        if (sender->m_broadcaster)
+            observers = sender->m_broadcaster->GetListenerGuids();
+        else
+            for (auto const& ref : sender->GetMap()->GetPlayers())
+                observers.insert(ref.getSource()->GetObjectGuid());
+        for (ObjectGuid const& guid : observers)
+        {
+            Player* observer = sender->GetMap()->GetPlayer(guid);
+            if (observer && observer != sender && observer->skateVisual.capable &&
+                observer->IsInVisibleList(sender))
+                observer->GetSession()->SendPacket(&packet);
+        }
+    }
+
+    static bool FreshVisual(VisualState const& state, uint32 now)
+    {
+        return state.active && WorldTimer::getMSTimeDiff(state.receipt, now) <= 2000;
+    }
+
+    static bool TakeVisualToken(VisualState& state, uint32 now, bool stopping)
+    {
+        uint32 elapsed = WorldTimer::getMSTimeDiff(state.budgetTime, now);
+        state.tokens = std::min(3.f, state.tokens + float(elapsed) * .03f);
+        state.budgetTime = now;
+        // Reserve one token for immediate off; hello cannot spend that reserve.
+        if (state.tokens < (stopping ? 1.f : 2.f))
+            return false;
+        state.tokens -= 1.f;
+        return true;
+    }
+
+    void ExpireVisual(Player* player)
+    {
+        auto& state = player->skateVisual;
+        if (state.active && !FreshVisual(state, WorldTimer::getMSTime()))
+        {
+            state.active = false;
+            state.payload.clear();
+        }
+    }
+
+    void QueueVisualCreate(Player const* sender, Player* observer, UpdateData& updates)
+    {
+        if (observer != sender && observer->skateVisual.capable &&
+            FreshVisual(sender->skateVisual, WorldTimer::getMSTime()))
+            updates.AddSkateVisual(VisualPacket(sender));
+    }
+
+    void ClearVisual(Player* player)
+    {
+        auto& state = player->skateVisual;
+        if (state.active && player->IsInWorld())
+        {
+            // An off snapshot has the same root and ride, no joints, and the next sequence.
+            state.payload.resize(44);
+            state.payload[14] = 0;
+            state.payload[43] = 0;
+            ++state.sequence;
+            for (unsigned i = 0; i < 4; ++i)
+                state.payload[6 + i] = uint8(state.sequence >> (8 * i));
+            state.receipt = WorldTimer::getMSTime();
+            RelayVisual(player);
+        }
+        bool capable = state.capable;
+        bool blocked = state.hasSequence || state.blocked;
+        uint32 blockedRide = state.hasSequence ? state.ride : state.blockedRide;
+        uint32 ride = state.ride;
+        uint32 sequence = state.sequence;
+        bool hasSequence = state.hasSequence;
+        state = VisualState{};
+        state.capable = capable; // negotiation belongs to the login session, not the map
+        state.blocked = blocked;
+        state.blockedRide = blockedRide;
+        state.ride = ride;
+        state.sequence = sequence;
+        state.hasSequence = hasSequence;
+    }
+
+    void HandleVisual(Player* player, ByteBuffer data, uint32 received)
+    {
+        if (!player || !player->IsInWorld() || player->IsBeingTeleported() ||
+            data.size() < 2 || data.size() > 8192 || data.read<uint8>(0) != 1)
+            return;
+        auto& state = player->skateVisual;
+        uint32 sinceEntry = received - state.mapEntry;
+        if (!sinceEntry || sinceEntry >= 0x80000000u ||
+            WorldTimer::getMSTimeDiff(received, WorldTimer::getMSTime()) > 2000)
+            return;
+        uint8 kind = data.read<uint8>(1);
+        if (kind == 0)
+        {
+            if (data.size() != 2)
+                return;
+            if (!TakeVisualToken(state, received, false))
+                return;
+            state.capable = true;
+            WorldPacket ack(SMSG_SKATECRAFT_VISUAL, 2);
+            ack << uint8(1) << uint8(0);
+            player->GetSession()->SendPacket(&ack);
+            // A client can negotiate after the initial visibility/create batch.
+            for (auto const& ref : player->GetMap()->GetPlayers())
+            {
+                Player* sender = ref.getSource();
+                if (sender != player && FreshVisual(sender->skateVisual, WorldTimer::getMSTime()) &&
+                    player->IsInVisibleList(sender))
+                {
+                    WorldPacket packet = VisualPacket(sender);
+                    player->GetSession()->SendPacket(&packet);
+                }
+            }
+            return;
+        }
+        uint32 ride, sequence;
+        bool active;
+        if (!state.capable || kind != 1 || !ValidateVisual(data, ride, sequence, active))
+            return;
+        uint32 delta = sequence - state.sequence;
+        uint32 rideDelta = ride - state.ride;
+        uint32 blockedDelta = ride - state.blockedRide;
+        if ((state.blocked && (!blockedDelta || blockedDelta >= 0x80000000u)) ||
+            (state.hasSequence && (ride == state.ride ? (!delta || delta >= 0x80000000u) :
+                                                       rideDelta >= 0x80000000u)))
+            return;
+        if (!TakeVisualToken(state, received, state.active && !active))
+            return;
+        state.ride = ride;
+        state.sequence = sequence;
+        state.active = active;
+        state.receipt = received;
+        state.hasSequence = true;
+        state.blocked = false;
+        state.payload.assign(data.contents(), data.contents() + data.size());
+        RelayVisual(player);
+    }
+
+    void ResetVisualSession(Player* player)
+    {
+        ClearVisual(player);
+        player->skateVisual = VisualState{};
+        player->skateVisual.mapEntry = WorldTimer::getMSTime();
+    }
+
+    void LoadSkillLine()
+    {
+        s_skillLine.id = SKILL_SKATEBOARDING;
+        s_skillLine.categoryId = SKILL_CATEGORY_SECONDARY;
+        for (auto& name : s_skillLine.name)
+            name = s_empty;
+        s_skillLine.name[0] = s_skillName;
+        s_skillLine.spellIcon = ICON_MECHASTRIDER;
+        if (sSkillLineStore.LookupEntry(SKILL_SKATEBOARDING) || !sSkillLineStore.InsertEntry(SKILL_SKATEBOARDING, &s_skillLine))
+        {
+            sLog.Out(LOG_BASIC, LOG_LVL_ERROR, "Skatecraft: skill line %u is taken or out of range; skateboarding is off.", SKILL_SKATEBOARDING);
+            return;
+        }
+
+        s_raceClass.skillId = SKILL_SKATEBOARDING;
+        s_raceClass.raceMask = 0;
+        s_raceClass.classMask = 0;
+        s_raceClass.flags = 0;
+        s_raceClass.reqLevel = 0;
+        s_raceClass.skillTierId = SKILL_TIER_300;
+        SkillRaceClassInfoBySkill.insert(SkillRaceClassInfoMap::value_type(SKILL_SKATEBOARDING, &s_raceClass));
+    }
+
+    static void AddSpell(uint32 id, char const* name, uint32 icon, uint32 castTimeIndex, uint32 durationIndex, uint32 cooldown, bool aura)
+    {
+        SpellEntry* spell = sSpellMgr.AddCustomSpell(id);
+        spell->Custom |= SPELL_CUSTOM_POSITIVE; // a buff we may cancel, not a debuff
+        spell->SpellName[0] = name;
+        spell->SpellIconID = icon;
+        spell->activeIconID = icon;
+        spell->CastingTimeIndex = castTimeIndex;
+        spell->DurationIndex = durationIndex;
+        spell->RecoveryTime = cooldown;
+        spell->StartRecoveryCategory = 133; // the global cooldown
+        spell->StartRecoveryTime = 1500;
+        spell->rangeIndex = 1;              // self
+        spell->baseLevel = 1;
+        spell->spellLevel = 1;
+        spell->InterruptFlags = castTimeIndex > 1 ? 0x0F : 0;
+        spell->Effect[EFFECT_INDEX_0] = aura ? SPELL_EFFECT_APPLY_AURA : SPELL_EFFECT_DUMMY;
+        spell->EffectApplyAuraName[EFFECT_INDEX_0] = aura ? SPELL_AURA_DUMMY : 0;
+        spell->EffectImplicitTargetA[EFFECT_INDEX_0] = TARGET_UNIT_CASTER;
+        spell->EffectDieSides[EFFECT_INDEX_0] = 1;
+        spell->DmgMultiplier[EFFECT_INDEX_0] = 1.f;
+    }
+
+    void LoadSpells()
+    {
+        // SpellCastTimes.dbc: 1 instant, 16 1.5 s. SpellDuration.dbc: 21 until cancelled, 2 30 s, 18 20 s, 36 1 s.
+        AddSpell(SPELL_SUMMON_SKATEBOARD, "Summon Skateboard", ICON_MECHASTRIDER, 16, 21, 0, true);
+        AddSpell(SPELL_OLLIE_BOOST, "Ollie Boost", ICON_BOOTS, 1, 2, 2 * MINUTE * IN_MILLISECONDS, true);
+        AddSpell(SPELL_ROCKET_BOOST, "Rocket Boost", ICON_FLARE, 1, 36, 30 * IN_MILLISECONDS, true);
+        AddSpell(SPELL_SPEED_DEMON, "Speed Demon", ICON_SPRINT, 1, 2, 3 * MINUTE * IN_MILLISECONDS, true);
+        AddSpell(SPELL_MOON_JUMP, "Moon Jump", ICON_MOONGLOW, 1, 18, 5 * MINUTE * IN_MILLISECONDS, true);
+    }
+
+    static void LearnUnlocked(Player* player)
+    {
+        uint32 skill = player->GetSkillValueBase(SKILL_SKATEBOARDING);
+        for (auto const& unlock : UNLOCKS)
+            if (skill >= unlock.skill && !player->HasSpell(unlock.spell))
+                player->LearnSpell(unlock.spell, false);
+    }
+
+    void OnLogin(Player* player)
+    {
+        if (!sSkillLineStore.LookupEntry(SKILL_SKATEBOARDING))
+            return;
+        if (!player->HasSkill(SKILL_SKATEBOARDING))
+            player->SetSkill(SKILL_SKATEBOARDING, 1, SKILL_MAX);
+        LearnUnlocked(player);
+    }
+
+    // Points a line needs to raise the skill at `skill`.
+    static float PointsNeeded(uint32 skill)
+    {
+        return 50.f + 5.f * skill;
+    }
+
+    static void LandLine(Player* player, float points)
+    {
+        if (!player->HasSkill(SKILL_SKATEBOARDING) || !player->HasAura(SPELL_SUMMON_SKATEBOARD))
+            return;
+
+        uint32 now = WorldTimer::getMSTime();
+        uint32& last = s_lastLine[player->GetGUIDLow()];
+        if (last && WorldTimer::getMSTimeDiff(last, now) < LINE_INTERVAL)
+            return;
+        last = now;
+
+        points = std::min(points, MAX_LINE_POINTS);
+        uint32 skill = player->GetSkillValueBase(SKILL_SKATEBOARDING);
+        float ratio = points / PointsNeeded(skill);
+
+        // A line worth the skill raises it by one, a bigger one by up to five.
+        uint32 gain = ratio >= 8.f ? 5 : ratio >= 4.f ? 3 : ratio >= 2.f ? 2 : ratio >= 1.f ? 1 : 0;
+        if (gain && skill < SKILL_MAX)
+        {
+            player->SetSkill(SKILL_SKATEBOARDING, std::min(skill + gain, SKILL_MAX), SKILL_MAX);
+            LearnUnlocked(player);
+        }
+
+        // Character XP: a same-level kill for a line worth the skill, up to four for a big one.
+        uint32 kill = 45 + 5 * player->GetLevel();
+        uint32 xp = uint32(kill * std::min(ratio, 4.f));
+        if (xp)
+            player->GiveXP(xp, nullptr);
+    }
+
+    bool HandleAddonMessage(Player* player, std::string const& message)
+    {
+        // A stock-safe probe must succeed before the client sends an extension opcode.
+        if (message == "SKATECRAFT\tV\t1")
+        {
+            WorldPacket response;
+            ChatHandler::BuildChatPacket(response, CHAT_MSG_PARTY, "SKATECRAFT\tCAPS\t1", LANG_ADDON,
+                                         CHAT_TAG_NONE, ObjectGuid());
+            player->GetSession()->SendPacket(&response);
+            return true;
+        }
+        static std::string const prefix = "SKATECRAFT\t";
+        if (message.compare(0, prefix.size(), prefix) != 0)
+            return false;
+        std::string body = message.substr(prefix.size());
+        if (body.compare(0, 2, "L\t") == 0)
+        {
+            float points = float(std::atof(body.c_str() + 2));
+            if (points > 0.f)
+                LandLine(player, points);
+        }
+        return true;
+    }
+
+    SpellCastResult CheckCast(Unit const* caster, SpellEntry const* spell)
+    {
+        switch (spell->Id)
+        {
+            case SPELL_SUMMON_SKATEBOARD:
+                if (caster->IsMounted())
+                    return SPELL_FAILED_NOT_MOUNTED;
+                if (caster->IsInCombat())
+                    return SPELL_FAILED_AFFECTING_COMBAT;
+                break;
+            case SPELL_OLLIE_BOOST:
+            case SPELL_ROCKET_BOOST:
+            case SPELL_SPEED_DEMON:
+            case SPELL_MOON_JUMP:
+                if (!caster->HasAura(SPELL_SUMMON_SKATEBOARD))
+                    return SPELL_FAILED_ONLY_MOUNTED;
+                break;
+        }
+        return SPELL_CAST_OK;
+    }
+}
+
+void WorldSession::HandleSkatecraftVisual(SkatecraftVisualPacket const& packet)
+{
+    Skatecraft::HandleVisual(GetPlayer(), packet.payload, packet.received);
+}
diff --git a/src/game/Skatecraft.h b/src/game/Skatecraft.h
new file mode 100644
index 0000000..a9bf703
--- /dev/null
+++ b/src/game/Skatecraft.h
@@ -0,0 +1,87 @@
+/*
+ * World of Skatecraft: Skateboarding, a secondary profession levelled by landing skate lines.
+ *
+ * The benilla client rides the Skate 3 engine and reports each landed line to us as an addon
+ * message ("SKATECRAFT\tL\t<points>"). We raise the Skateboarding skill, give character XP and
+ * teach the skate abilities as the skill grows. The skill line and the spells live in code, so
+ * the server needs no edited DBC files or database rows.
+ */
+
+#ifndef SKATECRAFT_H
+#define SKATECRAFT_H
+
+#include "Common.h"
+#include "SpellDefines.h"
+#include "Packet.h"
+#include <vector>
+
+class Player;
+class Unit;
+class SpellEntry;
+class ByteBuffer;
+class UpdateData;
+
+class SkatecraftVisualPacket final : public ClientPacket
+{
+public:
+    SkatecraftVisualPacket() : ClientPacket(OPCODE_WILL_BE_SET_IN_READ_FUNCTION) {}
+    ByteBuffer payload;
+    uint32 received = 0;
+    void ReadFromWorldPacket(WorldPacket& packet) override
+    {
+        opcode = packet.GetOpcode();
+        received = packet.GetPacketTime();
+        if (packet.size() && packet.size() <= 8192)
+            payload.append(packet.contents(), packet.size());
+        packet.rpos(packet.size());
+    }
+};
+
+namespace Skatecraft
+{
+    // Player lifetime is the session lifetime; every access runs on its map update thread.
+    struct VisualState
+    {
+        bool capable = false;
+        bool active = false;
+        bool hasSequence = false;
+        bool blocked = false;
+        uint32 blockedRide = 0;
+        uint32 mapEntry = 0;
+        uint32 budgetTime = 0;
+        float tokens = 3.f;
+        uint32 ride = 0;
+        uint32 sequence = 0;
+        uint32 receipt = 0;
+        std::vector<uint8> payload;
+    };
+
+    void HandleVisual(Player* player, ByteBuffer data, uint32 received);
+    void ExpireVisual(Player* player);
+    void QueueVisualCreate(Player const* sender, Player* observer, UpdateData& updates);
