@@ -0,0 +1,81 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <deque>
+#include <map>
+#include <string>
+namespace ai::conversation
+{
+// Budgets are UTF-8 bytes, not model tokens. Never cut a continuation byte.
+inline std::string Clip(std::string text, size_t bytes)
+{
+    if (text.size() <= bytes) return text;
+    while (bytes && (static_cast<unsigned char>(text[bytes]) & 0xc0) == 0x80) --bytes;
+    text.resize(bytes);
+    return text;
+}
+inline std::string OneLine(std::string text)
+{
+    for (char& c : text) if (static_cast<unsigned char>(c) < 32 || c == 127) c = ' ';
+    return text;
+}
+struct Turn
+{
+    uint64_t speaker;
+    int64_t time;
+    std::string scope, name, text;
+};
+class Journal
+{
+    std::deque<Turn> turns;
+public:
+    void Prune(int64_t now, size_t count, int64_t age)
+    {
+        while (!turns.empty() && (turns.size() > count || turns.front().time < now - age)) turns.pop_front();
+    }
+    void Add(Turn turn, int64_t now, size_t count, int64_t age)
+    {
+        turn.name = Clip(OneLine(turn.name), 64);
+        turn.text = Clip(OneLine(turn.text), 1024);
+        turns.push_back(std::move(turn));
+        Prune(now, count, age);
+    }
+    std::string Render(std::string const& scope, bool global, int64_t now, size_t count, int64_t age, size_t budget)
+    {
+        Prune(now, count, age);
+        std::string result;
+        for (auto it = turns.rbegin(); it != turns.rend(); ++it)
+        {
+            if (!global && it->scope != scope) continue;
+            std::string line = "[" + std::to_string(it->time) + " scope=" + it->scope + " speaker=" + std::to_string(it->speaker) + "] " + it->name + ": " + it->text + "\n";
+            if (result.size() + line.size() > budget) break; // retain whole, newest turns
+            result = line + result;
+        }
+        return result;
+    }
+};
+inline void FitHistory(std::string& history, size_t budget)
+{
+    while (history.size() > budget)
+    {
+        auto end = history.find('\n');
+        if (end == std::string::npos) { history.clear(); break; }
+        history.erase(0, end + 1);
+    }
+}
+// Substitute only original template tokens, never placeholders supplied in chat.
+inline std::string Expand(std::string const& input, std::map<std::string, std::string> const& values)
+{
+    std::string result;
+    for (size_t i = 0; i < input.size();)
+    {
+        bool found = false;
+        if (input[i] == '<') for (auto const& pair : values)
+            if (input.compare(i, pair.first.size(), pair.first) == 0)
+            { result += pair.second; i += pair.first.size(); found = true; break; }
+        if (!found) result += input[i++];
+    }
+    return result;
+}
+}
