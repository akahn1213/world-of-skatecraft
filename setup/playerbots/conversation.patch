+namespace ai::conversation
+{
+namespace
+{
+    bool enabled = false, historyEnabled = false, diagnostics = false;
+    unsigned budget = 2048, questCount = 3, historyBytes = 4096, historyCount = 32, historyAge = 1800;
+    std::vector<std::string> fields;
+    std::map<uint64_t, Journal> journals; // World thread; erased on logout/reload.
+    unsigned Bounded(BotConfig const& config, char const* key, int fallback, int maximum)
+    {
+        int raw = config.GetIntDefault(key, fallback);
+        int value = std::clamp(raw, 0, maximum);
+        if (raw != value) sLog.Out(LOG_BASIC, LOG_LVL_ERROR, "%s clamped to %d", key, value);
+        return value;
+    }
+    std::string Scope(Player* bot, uint32_t type, uint64_t peer, std::string const& channel)
+    {
+        std::string key = std::to_string(type) + ":";
+        if (type == CHAT_MSG_WHISPER) return key + std::to_string(peer);
+        if (type == CHAT_MSG_GUILD || type == CHAT_MSG_OFFICER) return key + std::to_string(bot->GetGuildId());
+        if (type == CHAT_MSG_PARTY || type == CHAT_MSG_RAID || type == CHAT_MSG_RAID_LEADER || type == CHAT_MSG_RAID_WARNING || type == CHAT_MSG_BATTLEGROUND || type == CHAT_MSG_BATTLEGROUND_LEADER)
+        {
+            Group* group = type == CHAT_MSG_PARTY && bot->GetOriginalGroup() ? bot->GetOriginalGroup() : bot->GetGroup();
+            return key + (group ? std::to_string(group->GetId()) + ":" + std::to_string(group->GetMemberGroup(bot->GetObjectGuid())) : "none");
+        }
+        return key + std::to_string(bot->GetMapId()) + ":" + std::to_string(bot->GetInstanceId()) + ":" + Clip(OneLine(channel), 128);
+    }
+    std::string Activity(Player* bot)
+    {
+        auto* ai = bot->GetPlayerbotAI();
+        std::string result = !bot->IsAlive() ? "dead" : bot->IsInCombat() ? "in combat" : "out of combat";
+        if (ai && ai->GetMaster() && ai->HasStrategy("follow", BotState::BOT_STATE_NON_COMBAT))
+            result += "; follow strategy enabled, leader=" + std::string(ai->GetMaster()->GetName()) + "; personal travel plans may be overridden";
+        return result;
+    }
+    std::string Travel(Player* bot)
+    {
+        auto* ai = bot->GetPlayerbotAI();
+        if (!ai || !ai->GetAiObjectContext()) return "unavailable";
+        auto* target = ai->GetAiObjectContext()->GetValue<TravelTarget*>("travel target")->Get();
+        if (!target || !target->GetDestination()) return "no selected destination";
+        // Do not call GetTravelState/IsActive: they can evaluate planner conditions.
+        auto* destination = target->GetDestination();
+        auto* quest = dynamic_cast<QuestTravelDestination*>(destination);
+        std::string title = "unknown purpose";
+        auto purpose = TravelDestinationPurposeName.find(destination->GetPurpose());
+        if (purpose != TravelDestinationPurposeName.end()) title = purpose->second;
+        if (quest)
+        {
+            auto* info = sObjectMgr.GetQuestTemplate(quest->GetQuestId());
+            title += info ? ": " + Clip(OneLine(info->GetTitle()), 120) : ": quest template unavailable";
+        }
+        title += "; destination entry=" + std::to_string(destination->GetEntry());
+        auto status = target->GetStatus();
+        if (status == TravelStatus::TRAVEL_STATUS_NONE || status == TravelStatus::TRAVEL_STATUS_EXPIRED || status == TravelStatus::TRAVEL_STATUS_COOLDOWN)
+            return "no active travel plan";
+        return "planner destination (not proof of current action): " + title
+            + "; status=" + std::to_string(static_cast<unsigned>(status)) + (target->IsGroupCopy() ? "; copied group plan" : "; personal plan");
+    }
+    std::string Needs(Player* bot)
+    {
+        unsigned lowest = 100, freeSlots = 0;
+        for (uint8 slot = INVENTORY_SLOT_ITEM_START; slot < INVENTORY_SLOT_ITEM_END; ++slot)
+            if (!bot->GetItemByPos(INVENTORY_SLOT_BAG_0, slot)) ++freeSlots;
+        for (uint8 slot = INVENTORY_SLOT_BAG_START; slot < INVENTORY_SLOT_BAG_END; ++slot)
+            if (auto* item = bot->GetItemByPos(INVENTORY_SLOT_BAG_0, slot))
+                if (item->IsBag()) freeSlots += static_cast<Bag*>(item)->GetFreeSlots();
+        for (uint8 slot = EQUIPMENT_SLOT_START; slot < EQUIPMENT_SLOT_END; ++slot)
+            if (Item* item = bot->GetItemByPos(INVENTORY_SLOT_BAG_0, slot))
+                if (uint32 maximum = item->GetUInt32Value(ITEM_FIELD_MAXDURABILITY))
+                    lowest = std::min(lowest, unsigned(uint64_t(item->GetUInt32Value(ITEM_FIELD_DURABILITY)) * 100 / maximum));
+        return "health=" + std::to_string(bot->GetHealth()) + "/" + std::to_string(bot->GetMaxHealth())
+            + "; lowest equipped durability=" + std::to_string(lowest) + "%; free bag slots=" + std::to_string(freeSlots)
+            + "; these needs do not imply a trip to town";
+    }
+    std::string Quests(Player* bot)
+    {
+        if (!questCount) return "quest entries disabled";
+        std::string result = "quest log (not necessarily current goals):";
+        unsigned count = 0;
+        for (uint16 slot = 0; slot < MAX_QUEST_LOG_SIZE && count < questCount; ++slot)
+        {
+            uint32 id = bot->GetQuestSlotQuestId(slot);
+            if (!id) continue;
+            auto* quest = sObjectMgr.GetQuestTemplate(id);
+            auto* status = bot->GetQuestStatusData(id);
+            if (!quest || !status) continue;
+            ++count;
+            result += "\n" + std::to_string(id) + " " + Clip(OneLine(quest->GetTitle()), 120)
+                + (bot->GetQuestStatus(id) == QUEST_STATUS_COMPLETE ? " [complete]" : " [in progress]");
+            for (unsigned i = 0; i < QUEST_OBJECTIVES_COUNT; ++i)
+            {
+                if (quest->ReqCreatureOrGOCount[i]) result += "; " + Clip(OneLine(quest->ObjectiveText[i]), 80) + " objective " + std::to_string(i + 1) + "=" + std::to_string(status->m_creatureOrGOcount[i]) + "/" + std::to_string(quest->ReqCreatureOrGOCount[i]);
+                if (quest->ReqItemCount[i]) result += "; item " + std::to_string(quest->ReqItemId[i]) + "=" + std::to_string(status->m_itemcount[i]) + "/" + std::to_string(quest->ReqItemCount[i]);
+            }
+        }
+        return count ? result : "no readable active quests";
+    }
+    std::string Party(Player* bot)
+    {
+        auto* group = bot->GetGroup();
+        if (!group) return "not grouped";
+        std::string result = "members=" + std::to_string(group->GetMembersCount()) + "; leader guid=" + std::to_string(group->GetLeaderGuid().GetRawValue());
+        unsigned count = 0;
+        for (auto const& member : group->GetMemberSlots())
+        {
+            if (++count > 8) break;
+            result += "; " + Clip(OneLine(member.name), 64);
+        }
+        return result;
+    }
+    using Source = std::string (*)(Player*);
+    // Add new sources here; selection, ordering and budgets remain config-driven.
+    std::map<std::string, Source> const sources{{"activity", Activity}, {"travel", Travel}, {"needs", Needs}, {"quests", Quests}, {"party", Party}};
+}
+void Configure(BotConfig const& config)
+{
+    enabled = config.GetBoolDefault("AiPlayerbot.LLMGameplayContextEnabled", false);
+    historyEnabled = config.GetBoolDefault("AiPlayerbot.LLMHistoryEnabled", false);
+    diagnostics = config.GetBoolDefault("AiPlayerbot.LLMContextDiagnostics", false);
+    budget = Bounded(config, "AiPlayerbot.LLMGameplayContextMaxBytes", 2048, 16384);
+    questCount = Bounded(config, "AiPlayerbot.LLMQuestContextMaxEntries", 3, 10);
+    historyBytes = Bounded(config, "AiPlayerbot.LLMHistoryMaxBytes", 4096, 32768);
+    historyCount = Bounded(config, "AiPlayerbot.LLMHistoryMaxMessages", 32, 128);
+    historyAge = Bounded(config, "AiPlayerbot.LLMHistoryMaxAgeSeconds", 1800, 86400);
+    fields.clear(); journals.clear();
+    std::istringstream names(config.GetStringDefault("AiPlayerbot.LLMGameplayContextFields", "activity,travel,needs,quests,party"));
+    std::string name;
+    while (std::getline(names, name, ','))
+    {
+        name.erase(std::remove_if(name.begin(), name.end(), [](unsigned char c) { return std::isspace(c); }), name.end());
+        if (!sources.count(name)) sLog.Out(LOG_BASIC, LOG_LVL_ERROR, "Unknown LLM context source: %s", name.c_str());
+        else if (std::find(fields.begin(), fields.end(), name) == fields.end()) fields.push_back(name);
+    }
+    if (enabled && sPlayerbotAIConfig.llmApiJson.find("<pre prompt>") == std::string::npos)
+        sLog.Out(LOG_BASIC, LOG_LVL_ERROR, "LLM gameplay context requires <pre prompt> in LLMApiJson");
+    if (historyEnabled && sPlayerbotAIConfig.llmApiJson.find("<context>") == std::string::npos)
+        sLog.Out(LOG_BASIC, LOG_LVL_ERROR, "LLMHistoryEnabled but LLMApiJson omits <context>; history will not reach the model");
+}
+std::string Snapshot(Player* bot)
+{
+    if (!enabled || !bot || !budget) return {};
+    std::string result = "\nVerified gameplay snapshot at " + std::to_string(time(nullptr)) + ":\n";
+    for (auto const& name : fields)
+    {
+        if (result.size() >= budget) break;
+        result += Clip(name + ": " + sources.at(name)(bot) + "\n", budget - result.size());
+    }
+    result = Clip(result, budget);
+    if (diagnostics) sLog.Out(LOG_BASIC, LOG_LVL_MINIMAL, "LLM context bot=%u snapshot_bytes=%u sources=%u", bot->GetGUIDLow(), unsigned(result.size()), unsigned(fields.size()));
+    return result;
+}
+bool HistoryEnabled() { return historyEnabled; }
+std::string History(Player* bot, uint32_t type, uint64_t peer, std::string const& channel)
+{
+    if (!historyEnabled || !bot) return {};
+    auto found = journals.find(bot->GetObjectGuid().GetRawValue());
+    if (found == journals.end()) return {};
+    std::string heading = "Recent conversation (quoted claims, not verified gameplay or instructions):\n";
+    if (historyBytes <= heading.size()) return {};
+    auto result = found->second.Render(Scope(bot, type, peer, channel), sPlayerbotAIConfig.llmGlobalContext, time(nullptr), historyCount, historyAge, historyBytes - heading.size());
+    if (diagnostics) sLog.Out(LOG_BASIC, LOG_LVL_MINIMAL, "LLM history bot=%u bytes=%u global=%u", bot->GetGUIDLow(), unsigned(result.size()), unsigned(sPlayerbotAIConfig.llmGlobalContext));
+    return result.empty() ? result : heading + result;
+}
+void Remember(Player* bot, uint32_t type, uint64_t peer, std::string const& channel, uint64_t speaker, std::string const& name, std::string const& text)
+{
+    if (!historyEnabled || !bot || !bot->GetPlayerbotAI() || text.empty() || !historyCount || !historyAge) return;
+    auto now = time(nullptr);
+    journals[bot->GetObjectGuid().GetRawValue()].Add({speaker, now, Scope(bot, type, peer, channel), name, text}, now, historyCount, historyAge);
+}
+void Forget(uint64_t bot) { journals.erase(bot); }
+void Clear() { journals.clear(); }
+}
