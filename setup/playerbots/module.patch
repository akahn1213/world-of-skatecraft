diff --git a/playerbot/VMangosItemCategories.cpp b/playerbot/VMangosItemCategories.cpp
new file mode 100644
index 0000000..73aa09b
--- /dev/null
+++ b/playerbot/VMangosItemCategories.cpp
@@ -0,0 +1,48 @@
+// GPL-2.0-or-later.
+#include "botpch.h"
+
+uint32 GetBotItemSubclass(ItemPrototype const* item)
+{
+    if (!item) return ITEM_SUBCLASS_CONSUMABLE_OTHER;
+    if (item->Class != ITEM_CLASS_CONSUMABLE || item->SubClass != ITEM_SUBCLASS_CONSUMABLE)
+        return item->SubClass;
+
+    // Classic has six scroll families, each with four ranks. These cannot be
+    // distinguished from elixirs by their generic stat aura alone.
+    switch (item->ItemId)
+    {
+        case 3012: case 1477: case 4425: case 10309:
+        case 955: case 2290: case 4419: case 10308:
+        case 3013: case 1478: case 4421: case 10305:
+        case 1181: case 1712: case 4424: case 10306:
+        case 1180: case 1711: case 4422: case 10307:
+        case 954: case 2289: case 4426: case 10310:
+            return ITEM_SUBCLASS_SCROLL;
+        default: break;
+    }
+    uint32 category = ITEM_SUBCLASS_CONSUMABLE_OTHER;
+    for (auto const& use : item->Spells)
+    {
+        if (!use.SpellId) continue;
+        SpellEntry const* spell = sSpellMgr.GetSpellEntry(use.SpellId);
+        if (!spell) continue;
+        auto specific = Spells::GetSpellSpecific(spell->Id);
+        if (specific == SPELL_FLASK_ELIXIR || spell->Id == 17626 || spell->Id == 17627 ||
+            spell->Id == 17628 || spell->Id == 17629 || spell->Id == 17624)
+            return ITEM_SUBCLASS_FLASK;
+        if (spell->Mechanic == MECHANIC_BANDAGE)
+            return ITEM_SUBCLASS_BANDAGE;
+        if (use.SpellCategory == 11 || use.SpellCategory == 59 ||
+            specific == SPELL_FOOD || specific == SPELL_DRINK ||
+            specific == SPELL_FOOD_AND_DRINK || specific == SPELL_WELL_FED)
+            return ITEM_SUBCLASS_FOOD;
+        if (specific == SPELL_BATTLE_ELIXIR || specific == SPELL_GUARDIAN_ELIXIR)
+            category = ITEM_SUBCLASS_ELIXIR;
+        else if (category != ITEM_SUBCLASS_ELIXIR && (use.SpellCategory == 4 || spell->Category == 4))
+            category = ITEM_SUBCLASS_POTION;
+        for (uint32 effect : spell->Effect)
+            if (effect == SPELL_EFFECT_ENCHANT_ITEM || effect == SPELL_EFFECT_ENCHANT_ITEM_TEMPORARY)
+                return ITEM_SUBCLASS_ITEM_ENHANCEMENT;
+    }
+    return category;
+}
diff --git a/playerbot/VMangosPathFinder.cpp b/playerbot/VMangosPathFinder.cpp
new file mode 100644
index 0000000..98f4d1d
--- /dev/null
+++ b/playerbot/VMangosPathFinder.cpp
@@ -0,0 +1,146 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "playerbot/VMangosPathFinder.h"
+#include "game/Objects/Unit.h"
+
+namespace ai
+{
+BotPathFinder::BotPathFinder(Unit const* unit, bool straight)
+    : owner(unit), mapId(unit ? unit->GetMapId() : 0)
+{
+    if (owner)
+    {
+        ownerPath = std::make_unique<PathInfo>(owner);
+        ownerPath->setUseStrightPath(straight);
+        ownerPath->SetTransport(owner->GetTransport());
+    }
+    filter.setIncludeFlags(NAV_GROUND | NAV_WATER);
+    filter.setExcludeFlags(NAV_MAGMA | NAV_SLIME | NAV_STEEP_SLOPES);
+}
+
+BotPathFinder::BotPathFinder(uint32 map, uint32 /*instanceId*/)
+    : BotPathFinder(nullptr)
+{
+    // vmangos shares the mesh and allocates a separate query for each thread.
+    mapId = map;
+}
+
+void BotPathFinder::setAreaCost(uint32 area, float cost)
+{
+    if (area >= DT_MAX_AREAS || cost <= 0.0f || !std::isfinite(cost)) return;
+    filter.setAreaCost(area, cost);
+    if (ownerPath) ownerPath->SetAreaCost(area, cost);
+}
+
+bool BotPathFinder::calculate(float x, float y, float z, bool force)
+{
+    if (!ownerPath) { points.clear(); type = PATHFIND_NOPATH; return false; }
+    return ownerPath->calculate(x, y, z, force);
+}
+
+bool BotPathFinder::calculate(Vector3 const& start, Vector3 end, bool force)
+{
+    if (ownerPath)
+        return ownerPath->calculate(start, end, force, owner->GetTransport() != nullptr);
+    requestedEnd = end;
+    points.clear();
+    type = PATHFIND_NOPATH;
+    if (!MaNGOS::IsValidMapCoord(start.x, start.y, start.z)
+        || !MaNGOS::IsValidMapCoord(end.x, end.y, end.z)) return false;
+    auto query = MMAP::MMapFactory::createOrGetMMapManager()->GetNavMeshQuery(mapId);
+    if (!query) return false;
+    float from[3] = {start.y, start.z, start.x}, to[3] = {end.y, end.z, end.x};
+    float bounds[3] = {5.0f, 5.0f, 5.0f}, nearestFrom[3], nearestTo[3];
+    dtPolyRef first = 0, last = 0;
+    if (dtStatusFailed(query->findNearestPoly(from, bounds, &filter, &first, nearestFrom)) || !first
+        || dtStatusFailed(query->findNearestPoly(to, bounds, &filter, &last, nearestTo)) || !last)
+        return false;
+    dtPolyRef corridor[MAX_PATH_LENGTH];
+    int count = 0;
+    if (dtStatusFailed(query->findPath(first, last, nearestFrom, nearestTo, &filter,
+                                     corridor, &count, MAX_PATH_LENGTH)) || !count) return false;
+    bool partial = corridor[count - 1] != last;
+    if (partial && dtStatusFailed(query->closestPointOnPoly(corridor[count - 1], nearestTo, nearestTo, nullptr)))
+        return false;
+    float straight[MAX_POINT_PATH_LENGTH * 3];
+    int pointCount = 0;
+    auto status = query->findStraightPath(nearestFrom, nearestTo, corridor, count, straight,
+                                         nullptr, nullptr, &pointCount, MAX_POINT_PATH_LENGTH);
+    if (dtStatusFailed(status) || pointCount < 2) return false;
+    // Preserve corners while sampling heights on the navigation surface. Sampling prevents
+    // routes crossing a hill from becoming a single segment through the terrain.
+    for (int i = 0; i < pointCount - 1; ++i)
+    {
+        float const* a = straight + i * 3;
+        float const* b = straight + (i + 1) * 3;
+        float length = std::hypot(b[0] - a[0], b[2] - a[2]);
+        int steps = std::max(1, int(std::ceil(length / 2.0f)));
+        for (int j = 0; j < steps; ++j)
+        {
+            float t = float(j) / steps;
+            float point[3] = {a[0] + (b[0]-a[0])*t, a[1] + (b[1]-a[1])*t, a[2] + (b[2]-a[2])*t};
+            dtPolyRef poly = 0;
+            float surface[3];
+            if (dtStatusFailed(query->findNearestPoly(point, bounds, &filter, &poly, surface)) || !poly)
+            { points.clear(); return false; }
+            points.emplace_back(surface[2], surface[0], surface[1]);
+        }
+    }
+    float const* final = straight + (pointCount - 1) * 3;
+    points.emplace_back(final[2], final[0], final[1]);
+    type = partial || dtStatusDetail(status, DT_BUFFER_TOO_SMALL) ? PATHFIND_INCOMPLETE : PATHFIND_NORMAL;
+    return true;
+}
+
+void BotPathFinder::setArea(uint32 map, float x, float y, float z, uint32 area, float radius)
+{
+    if (area >= DT_MAX_AREAS || radius <= 0 || !MaNGOS::IsValidMapCoord(x, y, z)) return;
+    auto manager = MMAP::MMapFactory::createOrGetMMapManager();
+    auto query = manager->GetNavMeshQuery(map);
+    auto mesh = const_cast<dtNavMesh*>(manager->GetNavMesh(map));
+    if (!query || !mesh) return;
+    float point[3] = {y,z,x}, bounds[3] = {5,5,5}, nearest[3];
+    dtPolyRef first = 0;
+    if (dtStatusFailed(query->findNearestPoly(point, bounds, &filter, &first, nearest)) || !first) return;
+    // A growing result buffer avoids silently omitting dense terrain polygons.
+    std::vector<dtPolyRef> polys(256);
+    int count = 0;
+    dtStatus status;
+    do
+    {
+        status = query->findPolysAroundCircle(first, nearest, radius, &filter,
+                                             polys.data(), nullptr, nullptr, &count, polys.size());
+        if (dtStatusDetail(status, DT_BUFFER_TOO_SMALL)) polys.resize(polys.size() * 2);
+    } while (dtStatusDetail(status, DT_BUFFER_TOO_SMALL));
+    if (dtStatusFailed(status)) return;
+    for (int i = 0; i < count; ++i)
+    {
+        unsigned char current;
+        if (dtStatusSucceed(mesh->getPolyArea(polys[i], &current)) && current < area)
+            mesh->setPolyArea(polys[i], area);
+    }
+}
+
+uint32 BotPathFinder::getArea(uint32 map, float x, float y, float z)
+{
+    if (!MaNGOS::IsValidMapCoord(x, y, z)) return 99;
+    auto query = MMAP::MMapFactory::createOrGetMMapManager()->GetNavMeshQuery(map);
+    if (!query) return 99;
+    float point[3] = {y,z,x}, bounds[3] = {5,5,5}, nearest[3];
+    dtPolyRef poly = 0;
+    if (dtStatusFailed(query->findNearestPoly(point, bounds, &filter, &poly, nearest)) || !poly) return 99;
+    unsigned char area;
+    return dtStatusSucceed(query->getAttachedNavMesh()->getPolyArea(poly, &area)) ? area : 99;
+}
+uint16 BotPathFinder::getFlags(uint32 map, float x, float y, float z)
+{
+    if (!MaNGOS::IsValidMapCoord(x, y, z)) return 0;
+    auto query = MMAP::MMapFactory::createOrGetMMapManager()->GetNavMeshQuery(map);
+    if (!query) return 0;
+    float point[3] = {y,z,x}, bounds[3] = {5,5,5}, nearest[3];
+    dtPolyRef poly = 0;
+    if (dtStatusFailed(query->findNearestPoly(point, bounds, &filter, &poly, nearest)) || !poly) return 0;
+    unsigned short flags = 0;
+    return dtStatusSucceed(query->getAttachedNavMesh()->getPolyFlags(poly, &flags)) ? flags : 0;
+}
+
+}
diff --git a/playerbot/VMangosPathFinder.h b/playerbot/VMangosPathFinder.h
new file mode 100644
index 0000000..71a76ad
