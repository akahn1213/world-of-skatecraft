+inline bool BotHasInterruptibleSpell(Unit* unit)
+{
+    // Match vmangos Spell::EffectInterruptCast, including channels. CMaNGOS's
+    // similarly named combat-interrupt flag is not the native kick predicate.
+    if (!unit) return false;
+    for (uint32 i = CURRENT_FIRST_NON_MELEE_SPELL; i < CURRENT_MAX_SPELL; ++i)
+        if (Spell* spell = unit->GetCurrentSpell(CurrentSpellTypes(i)))
+        {
+            if (i != CURRENT_CHANNELED_SPELL && !spell->GetCastTime()) continue;
+            auto const* info = spell->m_spellInfo;
+            if ((spell->getState() == SPELL_STATE_CASTING ||
+                 (spell->getState() == SPELL_STATE_PREPARING && spell->GetCastTime() > 0)) &&
+                info->PreventionType == SPELL_PREVENTION_TYPE_SILENCE &&
+                ((i == CURRENT_GENERIC_SPELL && info->HasSpellInterruptFlag(SPELL_INTERRUPT_FLAG_DAMAGE_PUSHBACK)) ||
+                 (i == CURRENT_CHANNELED_SPELL && info->HasChannelInterruptFlag(AURA_INTERRUPT_ACTION_CANCELS))))
+                return true;
+        }
+    return false;
+}
+inline bool IsSpellAppliesAura(SpellEntry const* info, uint32 mask = 7)
+{
+    for (uint32 i = 0; i < MAX_EFFECT_INDEX; ++i)
+        if ((mask & (1u << i)) && (info->Effect[i] == SPELL_EFFECT_APPLY_AURA || Spells::IsAreaAuraEffect(info->Effect[i])))
+            return true;
+    return false;
+}
+inline bool IsSpellHaveEffect(SpellEntry const* info, SpellEffects effect) { return info->HasEffect(effect); }
