+// CMaNGOS puts this in Player; vmangos exposes trainer records and teaching spells.
+// Keep bot provisioning in the module and use core eligibility and spell effects.
+static void LearnClassLevelSpells(Player* player)
+{
+    auto cls = sChrClassesStore.LookupEntry(player->GetClass());
+    if (!cls) return;
+    for (auto const& entry : sObjectMgr.GetQuestTemplates())
+    {
+        auto quest = entry.second.get();
+        if (quest->GetRequiredClasses() && player->SatisfyQuestClass(quest, false)
+            && player->SatisfyQuestRace(quest, false) && player->SatisfyQuestLevel(quest, false))
+            player->LearnQuestRewardedSpells(quest);
+    }
+    for (auto const& entry : sObjectMgr.GetCreatureInfoMap())
+    {
+        auto trainer = entry.second.get();
+        if (trainer->trainer_type != TRAINER_TYPE_CLASS || trainer->trainer_class != player->GetClass())
+            continue;
+        auto spells = trainer->trainer_id ? sObjectMgr.GetNpcTrainerTemplateSpells(trainer->trainer_id) : nullptr;
+        if (!spells) spells = sObjectMgr.GetNpcTrainerSpells(trainer->entry);
+        if (!spells) continue;
+        for (auto const& spellEntry : spells->spellList)
+        {
+            auto const& training = spellEntry.second;
+            auto teaching = sSpellMgr.GetSpellEntry(training.spell);
+            if (!teaching || teaching->Effect[0] != SPELL_EFFECT_LEARN_SPELL) continue;
+            auto learned = sSpellMgr.GetSpellEntry(teaching->EffectTriggerSpell[0]);
+            if (!learned || !SpellMgr::IsSpellValid(learned, player, false)) continue;
+            if (player->GetTrainerSpellState(&training) != TRAINER_SPELL_GREEN) continue;
+            if (learned->SpellFamilyName != cls->spellfamily)
+            {
+                auto bounds = sSpellMgr.GetSkillLineAbilityMapBoundsBySpellId(learned->Id);
+                if (bounds.first == bounds.second) continue;
+                switch (bounds.first->second->skillId)
+                {
+                    case SKILL_SUBTLETY: case SKILL_BEAST_MASTERY: case SKILL_SURVIVAL:
+                    case SKILL_DEFENSE: case SKILL_DUAL_WIELD: case SKILL_FERAL_COMBAT:
+                    case SKILL_PROTECTION: case SKILL_PLATE_MAIL: case SKILL_DEMONOLOGY:
+                    case SKILL_ENHANCEMENT: case SKILL_MAIL: case SKILL_HOLY2:
+                    case SKILL_LOCKPICKING: break;
+                    default: continue;
+                }
+            }
+            player->CastSpell(player, training.spell, true);
+        }
+    }
+}
