+// World-thread callbacks: resolve the controlling manager again after the database query.
+// It may have disappeared while a character was loading.
+void PlayerbotHolder::AddPlayerBot(uint32 playerGuid, uint32 masterAccountId)
+{
+    ObjectGuid guid(HIGHGUID_PLAYER, playerGuid);
+    if (ObjectAccessor::FindPlayerNotInWorld(guid)) return;
+    uint32 account = sObjectMgr.GetPlayerAccountIdByGUID(guid);
+    if (!account) return;
+    auto* query = new PlayerbotLoginQueryHolder(nullptr, masterAccountId, account, playerGuid);
+    if (!query->Initialize() || !CharacterDatabase.DelayQueryHolderUnsafe(static_cast<PlayerbotHolder*>(&sRandomPlayerbotMgr),
+        &PlayerbotHolder::HandlePlayerBotLoginCallback, query))
+        delete query;
+}
+
+void PlayerbotHolder::HandlePlayerBotLoginCallback(std::unique_ptr<QueryResult>, SqlQueryHolder* holder)
+{
+    std::unique_ptr<PlayerbotLoginQueryHolder> query(static_cast<PlayerbotLoginQueryHolder*>(holder));
+    if (!query || !sPlayerbotAIConfig.enabled) return;
+    ObjectGuid guid = query->GetGuid();
+    if (ObjectAccessor::FindPlayerNotInWorld(guid)) return;
+    uint32 masterAccount = query->GetMasterAccountId();
+    WorldSession* masterSession = masterAccount ? sWorld.FindSession(masterAccount) : nullptr;
+    Player* master = masterSession ? masterSession->GetPlayer() : nullptr;
+    if (masterAccount && (!master || !master->GetPlayerbotMgr())) return;
+    auto session = std::make_unique<WorldSession>(query->GetAccountId(), nullptr, SEC_PLAYER, 0, LOCALE_enUS);
+    session->SetAutonomousBot(true);
+    session->LoginAutonomousBot(query.release()); // Native loader consumes the query holder.
+    Player* bot = session->GetPlayer();
+    if (!bot)
+    {
+        sRandomPlayerbotMgr.OnPlayerLoginError(guid.GetCounter());
+        return;
+    }
+    bool allowed = bot->GetSession()->GetAccountId() == masterAccount ||
+        sPlayerbotAIConfig.IsInRandomAccountList(bot->GetSession()->GetAccountId()) ||
+        (master && sPlayerbotAIConfig.allowGuildBots && master->GetGuildId() && master->GetGuildId() == bot->GetGuildId()) ||
+        (!masterAccount && sPlayerbotAIConfig.IsFreeAltBot(bot));
+    if (!allowed)
+    {
+        session->LogoutPlayer(true);
+        return;
+    }
+    bot->RemovePlayerbotMgr();
+    sRandomPlayerbotMgr.OnPlayerLogin(bot);
+    PlayerbotHolder* owner = master ? static_cast<PlayerbotHolder*>(master->GetPlayerbotMgr()) : &sRandomPlayerbotMgr;
+    owner->OnBotLogin(bot);
+    session.release(); // The holder owns and updates socketless sessions until logout.
+}
+
+INSTANTIATE_SINGLETON_1(ai::PlayerBotLoginMgr);
