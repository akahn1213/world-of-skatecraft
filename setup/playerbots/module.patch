+namespace MaNGOS
+{
+class AnyUnitFulfillingConditionInRangeCheck
+{
+    WorldObject const* origin;
+    std::function<bool(Unit*)> predicate;
+    float range;
+    DistanceCalculation calculation;
+public:
+    AnyUnitFulfillingConditionInRangeCheck(WorldObject const* obj, std::function<bool(Unit*)> check, float radius, DistanceCalculation distance = DIST_CALC_COMBAT_REACH)
+        : origin(obj), predicate(std::move(check)), range(radius), calculation(distance) {}
+    bool operator()(Unit* unit) { return predicate(unit) && origin->GetDistance(unit, true, calculation) <= range; }
+};
+template<class Check> struct DynamicObjectListSearcher
+{
+    std::list<DynamicObject*>& result;
+    Check& check;
+    DynamicObjectListSearcher(std::list<DynamicObject*>& objects, Check& predicate) : result(objects), check(predicate) {}
+    void Visit(DynamicObjectMapType& objects)
+    {
+        for (auto& ref : objects)
+            if (check(ref.getSource())) result.push_back(ref.getSource());
+    }
+    template<class T> void Visit(GridRefManager<T>&) {}
+};
