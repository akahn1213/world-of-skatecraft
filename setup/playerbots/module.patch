+uint64 RpgZoneKey(WorldPosition const& pos)
+{
+    auto* area = pos.GetArea();
+    if (!area) return 0;
+    std::set<uint32> visited;
+    while (area->ZoneId)
+    {
+        if (!visited.insert(area->Id).second) return 0;
+        auto* parent = sAreaStorage.LookupEntry<AreaEntry>(area->ZoneId);
+        if (!parent) break;
+        area = parent;
+    }
+    return (uint64(pos.getMapId()) << 32) | area->Id;
+}
+bool ValidTeleportLocation(WorldLocation const& pos)
+{
+    return sMapStorage.LookupEntry<MapEntry>(pos.mapId) &&
+        MaNGOS::IsValidMapCoord(pos.x, pos.y, pos.z, pos.o);
+}
 }
 
