@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include "game/Maps/PathFinder.h"
+#include "game/Maps/MoveMap.h"
+#include <memory>
+
+namespace ai
+{
+// vmangos navigation areas use terrain flags as area IDs.
+constexpr uint32 NAV_AREA_WATER = NAV_WATER;
+constexpr uint32 NAV_AREA_GROUND_STEEP = NAV_STEEP_SLOPES;
+constexpr uint32 NAV_MAGMA_SLIME = NAV_MAGMA | NAV_SLIME;
+constexpr uint32 NAV_GROUND_STEEP = NAV_STEEP_SLOPES;
+
+class BotPathFinder
+{
+public:
+    explicit BotPathFinder(Unit const* owner, bool straight = false);
+    BotPathFinder(uint32 mapId, uint32 instanceId);
+    bool calculate(float x, float y, float z, bool force = false);
+    bool calculate(Vector3 const& start, Vector3 end, bool force = false);
+    PointsArray& getPath() { return ownerPath ? ownerPath->getFullPath() : points; }
+    PathType getPathType() const { return ownerPath ? ownerPath->getPathType() : type; }
+    Vector3 getEndPosition() const { return ownerPath ? ownerPath->getEndPosition() : requestedEnd; }
+    Vector3 getActualEndPosition() const { return ownerPath ? ownerPath->getActualEndPosition() : (points.empty() ? requestedEnd : points.back()); }
+    void setAreaCost(uint32 area, float cost);
+    // Called during travel-map initialization, before world/map updates begin.
+    void setArea(uint32 map, float x, float y, float z, uint32 area, float radius);
+    uint32 getArea(uint32 map, float x, float y, float z);
+    uint16 getFlags(uint32 map, float x, float y, float z);
+private:
+    Unit const* owner;
+    uint32 mapId;
+    std::unique_ptr<PathInfo> ownerPath;
+    PointsArray points;
+    Vector3 requestedEnd;
+    PathType type = PATHFIND_NOPATH;
+    dtQueryFilter filter;
+};
+}
diff --git a/playerbot/VMangosVendorItems.h b/playerbot/VMangosVendorItems.h
