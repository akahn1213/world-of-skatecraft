+// Native decoders throw ByteBufferException on truncated input. Bot-generated
+// packets bypass WorldSession::Update's exception boundary, so reject them here.
+template<class PacketType>
+inline bool DecodeBotPacket(PacketType& parsed, WorldPacket& packet)
+{
+    try
+    {
+        packet.rpos(0);
+        parsed.ReadFromWorldPacket(packet);
+        return true;
+    }
+    catch (ByteBufferException const&)
+    {
+        sLog.Out(LOG_BASIC, LOG_LVL_ERROR, "Playerbot rejected truncated packet 0x%x (%zu bytes)", packet.GetOpcode(), packet.size());
+        return false;
+    }
+}
+
+template<class PacketType>
+inline void DispatchBotPacket(WorldSession* session, void (WorldSession::*handler)(PacketType const&), PacketType const& packet)
+{
+    if (session) (session->*handler)(packet);
+}
+// Preserve synchronous bot actions while using vmangos's native packet decoding.
+template<class PacketType>
+inline void DispatchBotPacket(WorldSession* session, void (WorldSession::*handler)(PacketType const&), WorldPacket& packet)
+{
+    PacketType parsed;
+    if (session && DecodeBotPacket(parsed, packet))
+        (session->*handler)(parsed);
+}
+inline void DispatchBotPacket(WorldSession* session, void (WorldSession::*handler)(WorldPacket&), WorldPacket& packet)
+{
+    if (session) (session->*handler)(packet);
+}
+inline void DispatchBotPacket(WorldSession* session, void (WorldSession::*handler)(WorldPacket*), WorldPacket& packet)
+{
+    if (session) (session->*handler)(&packet);
+}
