+// Player owns its bot AI and, for human masters, its controlled-bot manager.
+void Player::CreatePlayerbotAI() { if (!m_playerbotAI) m_playerbotAI.reset(new PlayerbotAI(this)); }
+void Player::RemovePlayerbotAI() { m_playerbotAI.reset(); }
+void Player::CreatePlayerbotMgr() { if (!m_playerbotMgr) m_playerbotMgr.reset(new PlayerbotMgr(this)); }
+void Player::RemovePlayerbotMgr() { m_playerbotMgr.reset(); }
+bool Player::isRealPlayer() const { return !GetSession()->IsAutonomousBot() && !IsBot(); }
+
+void PlayerbotAIDeleter::operator()(PlayerbotAI* ai) const { delete ai; }
+void PlayerbotMgrDeleter::operator()(PlayerbotMgr* manager) const { delete manager; }
