+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <cstdlib>
+#include <filesystem>
+#include <string>
+
+// Resolve alongside mangosd -c, independently of the build/install prefix.
+inline std::string ResolveBotConfigPath(std::string const& mainConfig, char const* filename)
+{
+    auto overrideDir = std::getenv("PLAYERBOTS_CONFIG_DIR");
+    std::filesystem::path directory = overrideDir && *overrideDir
+        ? std::filesystem::path(overrideDir) : std::filesystem::path(mainConfig).parent_path();
+    if (directory.empty()) directory = ".";
+    return std::filesystem::absolute(directory / filename).lexically_normal().string();
+}
