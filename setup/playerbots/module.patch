+#endif
diff --git a/playerbot/VMangosBotHooks.cpp b/playerbot/VMangosBotHooks.cpp
new file mode 100644
index 0000000..c0a1a9b
--- /dev/null
+++ b/playerbot/VMangosBotHooks.cpp
@@ -0,0 +1,337 @@
+// GPL-2.0-or-later.
+#include "playerbot/VMangosBotHooks.h"
+#include "playerbot/PlayerbotMgr.h"
+#include "playerbot/PlayerbotAI.h"
+#include "playerbot/RandomPlayerbotMgr.h"
+#include "playerbot/PlayerbotAIConfig.h"
+#include "ahbot/AhBot.h"
+#include "playerbot/PlayerbotCommandServer.h"
+#include <deque>
+#include <atomic>
+
+namespace AutonomousBots
+{
+bool IsImmuneToSpell(Unit const* target, uint32 spellId)
+{
+    auto const* player = target && target->IsPlayer() ? static_cast<Player const*>(target) : nullptr;
+    return player && player->GetPlayerbotAI() && player->GetPlayerbotAI()->IsImmuneToSpell(spellId);
+}
+bool CanEnterArea(Player* player, AreaTriggerTeleport const* area)
+{
+    return player && area && player->GetPlayerbotAI() && player->GetPlayerbotAI()->CanEnterArea(area);
+}
+bool IgnoreSpellReagents(Unit const* caster)
+{
+    auto const* player = caster && caster->IsPlayer() ? static_cast<Player const*>(caster) : nullptr;
+    return player && player->GetPlayerbotAI() && player->GetPlayerbotAI()->HasCheat(BotCheatMask::item);
+}
+
+namespace
+{
+    std::atomic<bool> active{false};
+    uint64 nextLoginGeneration = 0;
+    std::map<ObjectGuid, uint64> loginGenerations;
+    struct DelayedDelivery
+    {
+        ObjectGuid player;
+        uint64 generation;
+        bool receive;
+        std::future<DelayedPackets> future;
+        DelayedPackets packets;
+        size_t index = 0;
+        std::chrono::steady_clock::time_point due;
+    };
+    std::list<DelayedDelivery> deliveries;
+    std::set<ObjectGuid> online; // Only accessed on the world thread.
+    struct Event { ObjectGuid player; bool outgoing; WorldPacket packet; };
+    std::mutex eventMutex;
+    std::deque<Event> events;
+    struct ChatEvent { ObjectGuid sender, recipient; uint32 type, language; std::string text, channel; };
+    std::deque<ChatEvent> chatEvents;
+    bool WatchesIncoming(uint16 opcode)
+    {
+        switch (opcode)
+        {
+        case CMSG_ACTIVATETAXI:
+        case CMSG_ACTIVATETAXIEXPRESS:
+        case CMSG_AREATRIGGER:
+        case CMSG_CAST_SPELL:
+        case CMSG_GAMEOBJ_USE:
+        case CMSG_GOSSIP_HELLO:
+        case CMSG_GROUP_UNINVITE:
+        case CMSG_GROUP_UNINVITE_GUID:
+        case CMSG_LOGOUT_CANCEL:
+        case CMSG_LOGOUT_REQUEST:
+        case CMSG_LOOT_ROLL:
+        case CMSG_PUSHQUESTTOPARTY:
+        case CMSG_QUESTGIVER_ACCEPT_QUEST:
+        case CMSG_QUESTGIVER_COMPLETE_QUEST:
+        case CMSG_QUESTGIVER_HELLO:
+        case CMSG_QUEST_CONFIRM_ACCEPT:
+        case CMSG_RECLAIM_CORPSE:
+        case CMSG_REPOP_REQUEST:
+        case CMSG_TAXICLEARALLNODES:
+        case CMSG_TAXICLEARNODE:
+            return true;
+        default: return false;
+        }
+    }
+    bool WatchesOutgoing(uint16 opcode)
+    {
+        switch (opcode)
+        {
+        case MSG_RAID_READY_CHECK:
+        case SMSG_BATTLEFIELD_STATUS:
+        case SMSG_BUY_FAILED:
+        case SMSG_CAST_RESULT:
+        case SMSG_DUEL_REQUESTED:
+        case SMSG_EMOTE:
+        case SMSG_FORCE_RUN_SPEED_CHANGE:
+        case SMSG_GROUP_INVITE:
+        case SMSG_GROUP_SET_LEADER:
+        case SMSG_GUILD_INVITE:
+        case SMSG_INVENTORY_CHANGE_FAILURE:
+        case SMSG_ITEM_PUSH_RESULT:
+        case SMSG_LEVELUP_INFO:
+        case SMSG_LOG_XPGAIN:
+        case SMSG_LOOT_RESPONSE:
+        case SMSG_LOOT_START_ROLL:
+        case SMSG_MESSAGECHAT:
+        case SMSG_MOVE_KNOCK_BACK:
+        case SMSG_PARTY_COMMAND_RESULT:
+        case SMSG_PETITION_SHOW_SIGNATURES:
+        case SMSG_PVP_CREDIT:
+        case SMSG_QUESTGIVER_QUEST_DETAILS:
+        case SMSG_QUESTUPDATE_ADD_ITEM:
+        case SMSG_QUESTUPDATE_ADD_KILL:
+        case SMSG_QUESTUPDATE_COMPLETE:
+        case SMSG_QUESTUPDATE_FAILED:
+        case SMSG_QUESTUPDATE_FAILEDTIMER:
+        case SMSG_QUEST_CONFIRM_ACCEPT:
+        case SMSG_RESURRECT_REQUEST:
+        case SMSG_SPELL_DELAYED:
+        case SMSG_SPELL_FAILURE:
+        case SMSG_SUMMON_REQUEST:
+        case SMSG_TEXT_EMOTE:
+        case SMSG_TRADE_STATUS:
+            return true;
+        default: return false;
+        }
+    }
+    void Queue(ObjectGuid player, WorldPacket const& packet, bool outgoing)
+    {
+        if (!active || !player || !(outgoing ? WatchesOutgoing(packet.GetOpcode()) : WatchesIncoming(packet.GetOpcode()))) return;
+        std::lock_guard<std::mutex> guard(eventMutex);
+        events.push_back({player, outgoing, packet});
+    }
+}
+
+void SchedulePackets(Player* player, std::future<DelayedPackets> packets, bool receive)
+{
+    if (!player || !packets.valid()) return;
+    auto found = loginGenerations.find(player->GetObjectGuid());
+    if (found == loginGenerations.end()) return;
+    deliveries.push_back({player->GetObjectGuid(), found->second, receive, std::move(packets)});
+}
+
+void Initialize()
+{
+    if (!sPlayerbotAIConfig.Initialize()) return;
+    auctionbot.Init();
+    active = true;
+}
+void OnLogin(Player* player)
+{
+    if (!active || !player || player->IsBot()) return;
+    online.insert(player->GetObjectGuid());
+    loginGenerations[player->GetObjectGuid()] = ++nextLoginGeneration;
+    if (!player->GetSession()->IsAutonomousBot())
+    {
+        player->CreatePlayerbotMgr();
+        player->GetPlayerbotMgr()->OnPlayerLogin(player);
+        sRandomPlayerbotMgr.OnPlayerLogin(player);
+    }
+}
+void OnLogout(Player* player)
+{
+    if (!active || !player) return;
+    online.erase(player->GetObjectGuid());
+    loginGenerations.erase(player->GetObjectGuid());
+    if (auto* manager = player->GetPlayerbotMgr()) manager->LogoutAllBots();
+    if (auto* ai = player->GetPlayerbotAI())
+        if (auto* owner = ai->GetHolder()) owner->DisablePlayerBot(player->GetGUIDLow(), false);
+    sRandomPlayerbotMgr.OnPlayerLogout(player);
+}
+void Shutdown()
+{
+    sPlayerbotCommandServer.Stop();
+    if (!active) return;
+    auto snapshot = online;
+    for (ObjectGuid guid : snapshot)
+        if (auto* player = ObjectAccessor::FindPlayer(guid))
+            if (auto* manager = player->GetPlayerbotMgr()) manager->LogoutAllBots();
+    sRandomPlayerbotMgr.LogoutAllBots();
+    active = false;
+    sPlayerbotAIConfig.enabled = false; // Reject login callbacks still queued during shutdown.
+    std::lock_guard<std::mutex> guard(eventMutex);
+    events.clear();
+    chatEvents.clear();
+    online.clear();
+    loginGenerations.clear();
+    deliveries.clear();
+}
+void Chat(ObjectGuid sender, uint32 type, uint32 language, std::string const& text, ObjectGuid recipient, std::string const& channel)
+{
+    if (!active || !sender || text.empty()) return;
+    std::lock_guard<std::mutex> guard(eventMutex);
+    chatEvents.push_back({sender, recipient, type, language, text, channel});
+}
+void Incoming(ObjectGuid player, WorldPacket const& packet) { Queue(player, packet, false); }
+void Outgoing(ObjectGuid player, WorldPacket const& packet) { Queue(player, packet, true); }
+
+void Update(uint32 diff)
+{
+    if (!active) return;
+    // Called only after map jobs and other world-update tasks have joined. Bots can
+    // inspect other players and transfer maps without racing a map worker.
+    std::deque<Event> pending;
+    { std::lock_guard<std::mutex> guard(eventMutex); pending.swap(events); }
+    for (auto const& event : pending)
+    {
+        Player* player = ObjectAccessor::FindPlayer(event.player);
+        if (!player) continue;
+        if (event.outgoing)
+        {
+            if (auto* ai = player->GetPlayerbotAI()) ai->HandleBotOutgoingPacket(event.packet);
+            if (auto* manager = player->GetPlayerbotMgr()) manager->HandleMasterOutgoingPacket(event.packet);
+        }
+        else if (auto* manager = player->GetPlayerbotMgr())
+            manager->HandleMasterIncomingPacket(event.packet);
+    }
+    std::deque<ChatEvent> chats;
+    { std::lock_guard<std::mutex> guard(eventMutex); chats.swap(chatEvents); }
+    for (auto const& chat : chats)
+    {
+        Player* sender = ObjectAccessor::FindPlayer(chat.sender);
+        if (!sender) continue;
+        if (chat.recipient)
+        {
+            if (Player* recipient = ObjectAccessor::FindPlayer(chat.recipient))
+                if (auto* ai = recipient->GetPlayerbotAI())
+                    ai->HandleCommand(chat.type, chat.text, *sender, chat.language);
+            continue;
+        }
+        switch (chat.type)
+        {
+        case CHAT_MSG_SAY:
+        case CHAT_MSG_YELL:
+        case CHAT_MSG_EMOTE:
+        case CHAT_MSG_CHANNEL:
+        case CHAT_MSG_GUILD:
+            sRandomPlayerbotMgr.HandleCommand(chat.type, chat.text, *sender, chat.channel,
+                sender->IsGameMaster() ? TEAM_BOTH_ALLOWED : sender->GetTeam(), chat.language);
+            if (chat.type != CHAT_MSG_GUILD)
+            {
+                if (auto* manager = sender->GetPlayerbotMgr())
+                    manager->HandleCommand(chat.type, chat.text, chat.language);
+                break;
+            }
+            [[fallthrough]];
+        case CHAT_MSG_PARTY:
+        case CHAT_MSG_RAID:
+        case CHAT_MSG_RAID_LEADER:
+        case CHAT_MSG_RAID_WARNING:
+        case CHAT_MSG_BATTLEGROUND:
+        case CHAT_MSG_BATTLEGROUND_LEADER:
+            for (ObjectGuid guid : std::set<ObjectGuid>(online))
+            {
+                Player* recipient = ObjectAccessor::FindPlayer(guid);
+                if (!recipient || !recipient->GetPlayerbotAI()) continue;
+                bool receives = false;
+                if (chat.type == CHAT_MSG_GUILD)
+                    receives = sender->GetGuildId() && sender->GetGuildId() == recipient->GetGuildId() && recipient->GetPlayerbotAI()->GetMaster() == sender;
+                else
+                {
+                    Group* group = sender->GetGroup();
+                    if (chat.type == CHAT_MSG_PARTY && sender->GetOriginalGroup()) group = sender->GetOriginalGroup();
+                    receives = group && group->IsMember(guid);
+                    if (receives && chat.type == CHAT_MSG_PARTY)
+                        receives = group->GetMemberGroup(guid) == group->GetMemberGroup(sender->GetObjectGuid());
+                }
+                if (receives) recipient->GetPlayerbotAI()->HandleCommand(chat.type, chat.text, *sender, chat.language);
+            }
+            break;
+        default: break;
+        }
+    }
+    auto now = std::chrono::steady_clock::now();
+    for (auto it = deliveries.begin(); it != deliveries.end();)
+    {
+        auto& delivery = *it;
+        // Poll network response futures without blocking the simulation. Keep a
+        // canceled future until ready: destroying std::async futures can wait.
+        if (delivery.future.valid())
+        {
+            if (delivery.future.wait_for(std::chrono::seconds(0)) != std::future_status::ready) { ++it; continue; }
+            try { delivery.packets = delivery.future.get(); }
+            catch (std::exception const& error)
+            {
+                sLog.Out(LOG_BASIC, LOG_LVL_ERROR, "Playerbot delayed response: %s", error.what());
+                it = deliveries.erase(it); continue;
+            }
+            delivery.due = now;
+            if (!delivery.receive && !delivery.packets.empty())
+                delivery.due += std::chrono::milliseconds(delivery.packets.front().second);
+        }
+        auto generation = loginGenerations.find(delivery.player);
+        Player* player = ObjectAccessor::FindPlayer(delivery.player);
+        if (!player || generation == loginGenerations.end() || generation->second != delivery.generation)
+        { it = deliveries.erase(it); continue; }
+        while (delivery.index < delivery.packets.size() && now >= delivery.due)
+        {
+            auto const& packet = delivery.packets[delivery.index];
+            if (delivery.receive)
+            {
+                if (auto* ai = player->GetPlayerbotAI()) ai->ReceiveDelayedPacketNow(packet.first);
+                delivery.due += std::chrono::milliseconds(packet.second);
+            }
+            else
+            {
+                auto binary = std::make_unique<WorldPacket>(packet.first);
+                player->GetSession()->QueueBinaryPacket(binary);
+            }
+            ++delivery.index;
+            if (!delivery.receive && delivery.index < delivery.packets.size())
+                delivery.due += std::chrono::milliseconds(delivery.packets[delivery.index].second);
+        }
+        if (delivery.index == delivery.packets.size()) it = deliveries.erase(it);
+        else ++it;
+    }
+    sPlayerbotCommandServer.Update();
+    sRandomPlayerbotMgr.UpdateAI(diff);
+    auto snapshot = online;
+    for (ObjectGuid guid : snapshot)
+    {
+        Player* player = ObjectAccessor::FindPlayer(guid);
+        if (!player) continue;
+        if (auto* ai = player->GetPlayerbotAI()) ai->UpdateAI(diff);
+        // AI updates can request a logout; look the player up again before access.
+        player = ObjectAccessor::FindPlayer(guid);
+        if (player)
+            if (auto* manager = player->GetPlayerbotMgr())
+            {
+                manager->UpdateAI(diff);
+                manager->UpdateSessions(diff);
+            }
+    }
+    sRandomPlayerbotMgr.UpdateSessions(diff);
+    static uint32 auctionElapsed = 0;
+    auctionElapsed += diff;
+    if (auctionElapsed >= 60000) { auctionElapsed = 0; auctionbot.Update(); }
+}
+bool DurabilityLoss(Player* player, Item* item, double percent)
+{
+    if (auto* ai = player->GetPlayerbotAI()) { ai->DurabilityLoss(item, percent); return true; }
+    return false;
+}
+}
