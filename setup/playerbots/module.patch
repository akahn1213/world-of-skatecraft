+// GPL-2.0-or-later. Visit vendors after vmangos has applied its patch filters.
+#pragma once
+#include "game/ObjectMgr.h"
+#include "game/Objects/CreatureDefines.h"
+namespace ai
+{
+template<class Visitor> void ForEachBotVendorItem(Visitor&& visit)
+{
+    for (auto const& record : sObjectMgr.GetCreatureInfoMap())
+    {
+        auto const* creature = record.second.get();
+        auto add = [&](VendorItemData const* items)
+        {
+            if (items) for (auto const* item : items->m_items)
+                if (item && sObjectMgr.GetItemPrototype(item->item)) visit(creature->entry, *item);
+        };
+        add(sObjectMgr.GetNpcVendorItemList(creature->entry));
+        if (creature->vendor_id) add(sObjectMgr.GetNpcVendorTemplateItemList(creature->vendor_id));
+    }
+}
+}
