+GameObject* GameObject::GetLinkedTrap()
+{
+    uint32 entry = GetGOInfo()->GetLinkedGameObjectEntry();
+    auto const* info = sObjectMgr.GetGameObjectTemplate(entry);
+    if (!info || info->type != GAMEOBJECT_TYPE_TRAP) return nullptr;
+    auto const* spell = sSpellMgr.GetSpellEntry(info->trap.spellId);
+    float range = spell ? Spells::GetSpellMaxRange(sSpellRangeStore.LookupEntry(spell->rangeIndex)) : 0.5f;
+    GameObject* trap = nullptr;
+    MaNGOS::NearestGameObjectEntryInObjectRangeCheck check(*this, entry, range);
+    MaNGOS::GameObjectLastSearcher<MaNGOS::NearestGameObjectEntryInObjectRangeCheck> searcher(trap, check);
+    Cell::VisitGridObjects(this, searcher, range);
+    return trap && trap->isSpawned() ? trap : nullptr;
+}
