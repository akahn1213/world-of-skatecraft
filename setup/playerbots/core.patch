+bool LFGQueue::GetGroupQueueInfo(LFGGroupQueueInfo* result, uint32 groupId) const
+{
+    std::lock_guard<std::mutex> guard(m_snapshotMutex);
+    auto it = m_groupsSnapshot.find(groupId);
+    if (it == m_groupsSnapshot.end()) return false;
+    if (result) *result = it->second;
+    return true;
+}
+bool LFGQueue::GetPlayerQueueInfo(LFGPlayerQueueInfo* result, ObjectGuid guid) const
+{
+    std::lock_guard<std::mutex> guard(m_snapshotMutex);
+    auto it = m_playersSnapshot.find(guid);
+    if (it == m_playersSnapshot.end()) return false;
+    if (result) *result = it->second;
+    return true;
+}
+
+void LFGQueue::PlayerJoinedGroup(ObjectGuid guid, uint32 groupArea)
+{
+    auto it = m_queuedPlayers.find(guid);
+    if (it != m_queuedPlayers.end())
+        RemovePlayerFromQueue(guid, groupArea && it->second.areaId == groupArea ? PLAYER_SYSTEM_LEAVE : PLAYER_CLIENT_LEAVE);
+}
