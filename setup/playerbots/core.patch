+bool Map::HasRealPlayers() const
+{
+    for (auto const& ref : GetPlayers())
+        if (Player* player = ref.getSource())
+            if (player->IsInWorld() && !player->IsBot() && !player->GetSession()->IsAutonomousBot())
+                return true;
+    return false;
+}
+bool Map::HasActiveZones() const
+{
+    for (auto const& ref : GetPlayers())
+        if (Player* player = ref.getSource())
+            if (player->IsInWorld() && !player->IsBot() && !player->GetSession()->IsAutonomousBot()
+                && !player->IsAFK() && player->IsGMVisible()) return true;
+    return false;
+}
+bool Map::HasActiveZone(uint32 zone) const
+{
+    for (auto const& ref : GetPlayers())
+        if (Player* player = ref.getSource())
+            if (player->IsInWorld() && !player->IsBot() && !player->GetSession()->IsAutonomousBot()
+                && !player->IsAFK() && player->IsGMVisible() && player->GetZoneId() == zone) return true;
+    return false;
+}
