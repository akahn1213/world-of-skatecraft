+bool MotionMaster::MoveFall()
+{
+    float x = m_owner->GetPositionX(), y = m_owner->GetPositionY(), z = m_owner->GetPositionZ();
+    float ground = m_owner->GetMap()->GetHeight(x, y, z);
+    if (ground <= INVALID_HEIGHT || z - ground < 0.5f) return false;
+    Clear(false);
+    MoveIdle();
+    Movement::MoveSplineInit init(*m_owner, "BotFall");
+    init.MoveTo(x, y, ground, false);
+    init.SetFall();
+    init.Launch();
+    return true;
+}
+
+void MotionMaster::MovePoint(uint32 id, float x, float y, float z, BotForcedMovement mode, bool generatePath)
+{
+    uint32 options = generatePath ? MOVE_PATHFINDING : MOVE_NONE;
+    if (mode == FORCED_MOVEMENT_WALK) options |= MOVE_WALK_MODE;
+    if (mode == FORCED_MOVEMENT_RUN) options |= MOVE_RUN_MODE;
+    if (mode == FORCED_MOVEMENT_FLIGHT) options |= MOVE_FLY_MODE;
+    MovePoint(id, x, y, z, options);
+}
+void MotionMaster::MovePath(std::vector<G3D::Vector3> const& path, BotForcedMovement mode, bool flying, bool cyclic)
+{
+    if (path.size() < 2) return;
+    uint32 options = cyclic ? MOVE_CYCLIC : MOVE_NONE;
+    if (mode == FORCED_MOVEMENT_WALK) options |= MOVE_WALK_MODE;
+    if (mode == FORCED_MOVEMENT_RUN) options |= MOVE_RUN_MODE;
+    if (flying || mode == FORCED_MOVEMENT_FLIGHT) options |= MOVE_FLY_MODE;
+    if (m_owner->IsPlayer()) Mutate(new PointMovementGenerator<Player>(path, options));
+    else Mutate(new PointMovementGenerator<Creature>(path, options));
+}
+
+void MotionMaster::MovePoint(uint32 id, Position const& position, BotForcedMovement mode, float speed, bool generatePath)
+{
+    uint32 options = generatePath ? MOVE_PATHFINDING : MOVE_NONE;
+    if (mode == FORCED_MOVEMENT_WALK) options |= MOVE_WALK_MODE;
+    if (mode == FORCED_MOVEMENT_RUN) options |= MOVE_RUN_MODE;
+    if (mode == FORCED_MOVEMENT_FLIGHT) options |= MOVE_FLY_MODE;
+    MovePoint(id, position.x, position.y, position.z, options, speed);
+}
