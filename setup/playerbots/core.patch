+    if (!HasUnitState(UNIT_STATE_MELEE_ATTACKING)) return;
+    ClearUnitState(UNIT_STATE_MELEE_ATTACKING);
+    InterruptSpell(CURRENT_MELEE_SPELL);
+    if (target) SendMeleeAttackStop(target);
+}
+
+uint32 Unit::GetAuraCount(uint32 spellId) const
+{
+    uint32 count = 0;
+    auto bounds = GetSpellAuraHolderBounds(spellId);
+    for (auto it = bounds.first; it != bounds.second; ++it)
+        count += std::max<uint32>(1, it->second->GetStackAmount());
+    return count;
+}
+void Unit::FixateTarget(Unit* target)
+{
+    if (CanHaveThreatList()) GetThreatManager().FixateTarget(target);
+}
+
+bool Unit::IsInTeam(Unit const* other, bool ignoreCharms) const
+{
+    if (!other) return false;
+    if (this == other) return true;
+    if (!HasFlag(UNIT_FIELD_FLAGS, UNIT_FLAG_PLAYER_CONTROLLED) || !other->HasFlag(UNIT_FIELD_FLAGS, UNIT_FLAG_PLAYER_CONTROLLED)) return false;
+    Player const* left = ignoreCharms ? GetOwnerPlayerOrPlayerItself() : GetCharmerOrOwnerPlayerOrPlayerItself();
+    Player const* right = ignoreCharms ? other->GetOwnerPlayerOrPlayerItself() : other->GetCharmerOrOwnerPlayerOrPlayerItself();
+    return left && right && (left == right || left->GetTeam() == right->GetTeam());
+}
